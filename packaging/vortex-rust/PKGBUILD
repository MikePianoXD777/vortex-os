# vortex-rust: los programas de Vortexine's OS ya reescritos en Rust (la 4.0 los va pasando uno por uno).
# Se COMPILA aquí mismo desde rust/ de este repo; no se baja ningún binario ya hecho.
#
# Por ahora trae:
#   - vortex-bt-agente: el agente de Bluetooth (~4,6 MB de RAM contra ~33 MB del de Python). El script de
#     /usr/local/bin/vortex-bt-agente salta a este binario si existe, así el servicio no cambia.
#   - vortex-tareas-rs y vortex-usb-rs: los ayudantes que siempre corren (las tareas de la barra, ~1 MB en vez de
#     ~22; el montador de memorias USB, ~1 MB en vez de ~12). Sin Qt. bin/vortex-tareas (Python) y bin/vortex-usb (bash)
#     saltan a estos binarios si existen; con VORTEX_TAREAS_PYTHON=1 / VORTEX_USB_BASH=1 se fuerzan los viejos.
#   - vortex-enlace-rs (lo escribió Mike): «bajar con copiar el enlace». wl-paste lo corre en cada copia; bin/vortex-enlace
#     salta a este si existe (VORTEX_ENLACE_PYTHON=1 fuerza el de Python).
#   - vortex-memoria-rs (también de Mike): el aviso de poca memoria. El gestor lo llama directo; bin/vortex-memoria
#     salta a este si existe (VORTEX_MEMORIA_PYTHON=1 fuerza el de Python).
#   - vortex-task-manager-rs, vortex-runner-rs, vortex-video-rs, vortex-shop-rs, vortex-app-installer-rs,
#     vortex-connect-rs y vortex-shared-rs (+ vortex-shared-motor, el servicio sin Qt): las apps con ventana (cxx-qt, los mismos
#     QML). Su lanzador de Python (/usr/bin/vortex-…) salta al de Rust si existe; con
#     VORTEX_<APP>_PYTHON=1 se fuerza el de Python. Video usa los QML del paquete vortex-video.
#   - vortex-gestor-rs: el gestor de recursos (foco, scopes, modo juego, modo IA, presión de memoria), sin Qt, en un
#     solo proceso: reemplaza al bash bin/vortex-gestor y a su ayudante en C vortex-eventos. El script
#     /usr/bin/vortex-gestor salta a este binario si existe; con VORTEX_GESTOR_BASH=1 se fuerza el bash.
#   - vortex-camera-rs: Vortexine's Camera (cxx-qt, los mismos QML). Su lanzador (el que deja «vortex camara
#     instalar») salta a este si existe; VORTEX_CAMERA_PYTHON=1 fuerza la de Python.
#   - vortex-player-rs: Vortex Player (cxx-qt, los mismos QML del paquete vortex-player). Su lanzador
#     (/usr/bin/vortex-player) salta a este si existe; VORTEX_PLAYER_PYTHON=1 fuerza la de Python.
#   - vortex-local-ai-rs: Vortexine's Local AI (cxx-qt, los mismos QML: chat con Ollama, modelos, vault y memoria). Su
#     lanzador (/usr/bin/vortex-local-ai) salta a este si existe; VORTEX_LOCAL_AI_PYTHON=1 fuerza la de Python.
#   - vortex-miku-rs (miku-rs) y miku-aux: Miku (cxx-qt: el panel de voz y el avatar en QtWebEngine, con los mismos
#     colores) y sus ayudantes (el servidor MCP de las acciones, el hook de internet y los mejores momentos). La
#     persona, la página web (web/), el catálogo de voces y la voz en Python (Supertonic, voz natural, ElevenLabs)
#     siguen en el paquete vortex-miku: el lanzador (/usr/bin/vortex-miku) salta a este binario si existe y le pasa
#     VORTEX_MIKU_RAIZ; con VORTEX_MIKU_PYTHON=1 se fuerza la de Python.
#   - vortex-miku-rs: el comando «vortex-miku» en Rust (avatar, estado, modelo, voz, ia, cámara, compañera, habla-sola,
#     grabar, sentir…), con los mismos textos, códigos y archivos que el de Python. El lanzador /usr/bin/vortex-miku
#     (paquete vortex-miku) salta a este si existe. Solo «natural» y «elevenlabs» (instalar la voz con pip, la clave en
#     el llavero) se le pasan a vortex-miku-python.
#   - miku-voz (vortex-miku-voz): la voz de fábrica de Miku (Supertonic 3) en Rust, con el protocolo de voz_worker.py;
#     onnxruntime se carga al arrancar (la libonnxruntime.so de python-onnxruntime-cpu), no se baja al compilar.
#     ElevenLabs y la voz natural siguen en Python; VORTEX_MIKU_VOZ_PYTHON=1 fuerza la de Python.
#   - vortex-tirones (nuevo en la 4.0, solo en Rust): el detector de tirones de los juegos. Lo arranca el gestor al
#     abrir un juego y vortex-partida pone lo que encontró en el resumen del final; «vortex tirones» da el detalle.
#   - vortex-traducir (4.0, solo en Rust): Super+Alt+T traduce lo seleccionado con la IA local (Ollama).
#   - vortex-limpieza (4.0, solo en Rust): la limpieza de la semana (temporizador de usuario que deja «vortex»).
#   - vortex-mascota (4.1, solo en Rust): la compañera de escritorio, un sprite que camina por la pantalla
#     (capa de Wayland, sin Qt: casi no gasta). De fábrica un diseño original; cada quien puede poner su paquete
#     Shimeji o de tiras (animations.json + spritesheets_128/) en ~/.local/share/vortex/mascota
#     («vortex mascota usar CARPETA|ARCHIVO.zip»). El repo no trae personajes ajenos.
#   - vortex-usb-rs también respalda a una memoria marcada «Usar para respaldos» (4.0).
#   - vortex-lluvia (4.3, solo en Rust): la lluvia de dígitos que abre la terminal antes del saludo
#     (config/terminal/saludo.sh). «vortex saludo lluvia off» la apaga.
#   - Vortex Player (4.1): avisa por MPRIS cuando cambia CanSeek y manda la duración de mpv si la canción no la
#     trae: la barra del panel de música ya deja elegir el tiempo.
#
#   cd packaging/vortex-rust && makepkg -si
pkgname=vortex-rust
pkgver=0.1.0
pkgrel=23
pkgdesc="Programas de Vortexine's OS reescritos en Rust (Bluetooth, gestor de recursos, tareas, USB, enlace, memoria, tirones, Task Manager, Runner, Video, Shop, App Installer, Connect, Shared, Camera, Player, Local AI, Miku, traducir y limpieza)"
arch=('x86_64')
url='https://github.com/MikePianoXD777/vortex-os'
license=('MIT')
depends=('gcc-libs' 'glibc' 'dbus' 'libnotify' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-webengine' 'qt6-webchannel' 'curl' 'wl-clipboard')
optdepends=('vortex-video: los QML y el reproductor de Vortex Video (qt6-multimedia)'
            'vortex-player: los QML de Vortex Player (y mpv, ffmpeg, yt-dlp)'
            'vortex-miku: la persona, la página del avatar y la voz de Miku (python, supertonic)')
makedepends=('cargo' 'qt6-base' 'qt6-declarative' 'qt6-webengine')
options=('!lto')

_raiz() { echo "$startdir/../../rust"; }
_crates=(vortex-bt-agente vortex-gestor vortex-tareas vortex-usb vortex-enlace vortex-memoria vortex-tirones vortex-task-manager-qt vortex-runner-qt vortex-video-qt vortex-shop-qt
         vortex-app-installer-qt vortex-connect-qt vortex-shared vortex-shared-qt vortex-camera-qt vortex-local-ai-qt
         vortex-player-qt vortex-miku vortex-miku-qt vortex-miku-voz vortex-traducir vortex-limpieza vortex-mascota vortex-lluvia)
_paquetes() { local c; for c in "${_crates[@]}"; do printf -- '-p %s ' "$c"; done; }
# 4.1: con rustup en ~/.cargo/bin (antes que /usr/bin en el PATH), «stable» puede ser más vieja que la que
# pide el workspace (rust-version 1.100) y la construcción fallaba aunque el sistema trajera la buena. Se
# usa el cargo de /usr/bin primero (el del paquete rust; con rustup instalado por pacman es su proxy).
_cargo_del_sistema() { [[ -x /usr/bin/cargo ]] && export PATH="/usr/bin:$PATH"; return 0; }

prepare() {
    cd "$(_raiz)"
    _cargo_del_sistema
    # El rust-toolchain.toml del repo pide una versión fija con rustup; aquí basta la estable del sistema.
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$(_raiz)"
    _cargo_del_sistema
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
    # Dos a la vez: con más, cxx-qt se come la memoria de una PC chica.
    # shellcheck disable=SC2046
    CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}" QMAKE="${QMAKE:-qmake6}" cargo build --release --frozen $(_paquetes)
}

check() {
    cd "$(_raiz)"
    _cargo_del_sistema
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
    command -v dbus-daemon >/dev/null || return 0
    cargo test --release --frozen -p vortex-bt-agente -p vortex-tareas -p vortex-usb -p vortex-enlace -p vortex-gestor -p vortex-memoria -p vortex-tirones -p vortex-traducir -p vortex-limpieza -p vortex-mascota -p vortex-lluvia -p vortex-miku
    # El motor de Camera se prueba contra una cámara falsa de verdad (RTSP con ffmpeg y python3).
    if command -v ffmpeg >/dev/null && command -v python3 >/dev/null; then
        cargo test --release --frozen -p vortex-camera
    fi
    # El motor de Local AI se prueba contra un Ollama falso por HTTP (y un `ollama` falso hecho con python3).
    if command -v python3 >/dev/null; then
        cargo test --release --frozen -p vortex-local-ai
    fi
    # El motor del Player (mpv, MPRIS en un bus propio, Discord, la nube con un Google falso).
    if command -v mpv >/dev/null; then
        cargo test --release --frozen -p vortex-player
    fi
}

package() {
    local r b="$srcdir/target/release" a
    r="$(_raiz)"
    install -Dm755 "$b/vortex-bt-agente" "$pkgdir/usr/lib/vortex/vortex-bt-agente"
    install -Dm755 "$b/vortex-tareas-rs" "$pkgdir/usr/lib/vortex/vortex-tareas-rs"
    install -Dm755 "$b/vortex-usb-rs" "$pkgdir/usr/lib/vortex/vortex-usb-rs"
    install -Dm755 "$b/vortex-enlace-rs" "$pkgdir/usr/lib/vortex/vortex-enlace-rs"
    install -Dm755 "$b/vortex-memoria-rs" "$pkgdir/usr/lib/vortex/vortex-memoria-rs"
    install -Dm755 "$b/vortex-shared-motor" "$pkgdir/usr/lib/vortex/vortex-shared-motor"
    install -Dm755 "$b/vortex-gestor-rs" "$pkgdir/usr/lib/vortex/vortex-gestor-rs"
    install -Dm755 "$b/vortex-tirones" "$pkgdir/usr/bin/vortex-tirones"
    install -Dm755 "$b/vortex-traducir" "$pkgdir/usr/bin/vortex-traducir"
    install -Dm755 "$b/vortex-limpieza" "$pkgdir/usr/bin/vortex-limpieza"
    install -Dm755 "$b/vortex-mascota" "$pkgdir/usr/bin/vortex-mascota"
    install -Dm755 "$b/vortex-lluvia" "$pkgdir/usr/bin/vortex-lluvia"
    for a in task-manager runner video shop app-installer connect shared camera local-ai player; do
        install -Dm755 "$b/vortex-$a-rs" "$pkgdir/usr/lib/vortex/vortex-$a-rs"
    done
    # Miku: su ventana y su ayudante. La persona, web/ y la voz siguen en el paquete vortex-miku.
    install -Dm755 "$b/miku-rs" "$pkgdir/usr/lib/vortex/miku-rs"
    install -Dm755 "$b/miku-aux" "$pkgdir/usr/lib/vortex/miku-aux"
    install -Dm755 "$b/vortex-miku-rs" "$pkgdir/usr/lib/vortex/vortex-miku-rs"
    # La voz Supertonic en Rust (carga la libonnxruntime.so de python-onnxruntime-cpu, que trae vortex-miku).
    install -Dm755 "$b/miku-voz" "$pkgdir/usr/lib/vortex/miku-voz"
    install -d "$pkgdir/usr/share/vortex-miku-rs/qml"
    cp -r "$r/apps/miku/qt/qml/." "$pkgdir/usr/share/vortex-miku-rs/qml/"
    # Los QML que cambian respecto a los de Python (Video usa los del paquete vortex-video).
    install -d "$pkgdir/usr/share/vortex-task-manager/qml" "$pkgdir/usr/share/vortex-runner-rs/qml"
    cp -r "$r/apps/vortex-task-manager/qml/." "$pkgdir/usr/share/vortex-task-manager/qml/"
    cp -r "$r/apps/vortex-runner/qt/qml/." "$pkgdir/usr/share/vortex-runner-rs/qml/"
    for a in shop app-installer connect shared; do
        install -d "$pkgdir/usr/share/vortex-$a-rs/qml"
        cp -r "$r/apps/vortex-$a/qt/qml/." "$pkgdir/usr/share/vortex-$a-rs/qml/"
    done
    # Camera no viene de fábrica («vortex camara instalar»): su lanzador le pasa sus propios QML; esta copia
    # es por si se abre el binario solo.
    install -d "$pkgdir/usr/share/vortex-camera-rs/qml"
    cp -r "$r/../apps/vortex-camera/vortex_camera/qml/." "$pkgdir/usr/share/vortex-camera-rs/qml/"
    # Local AI trae sus QML en el paquete vortex-local-ai; su lanzador le pasa los suyos, y esta copia es por si
    # se abre el binario solo.
    install -d "$pkgdir/usr/share/vortex-local-ai-rs/qml"
    cp -r "$r/../apps/vortex-local-ai/vortex_local_ai/qml/." "$pkgdir/usr/share/vortex-local-ai-rs/qml/"
    find "$pkgdir/usr/share" -type f -exec chmod 644 {} +
}
