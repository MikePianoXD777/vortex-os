# Miku, la asistente de voz de Vortexine's OS (SUPER + O), empaquetada desde apps/miku/ de este repo:
#   - el comando /usr/bin/vortex-miku y la app (Python + PySide6) en /usr/share/vortex-miku;
#   - el 3D con three.js y @pixiv/three-vrm (MIT), que se bajan aquí con versión fija y sha256 y se
#     dejan en /usr/share/vortex-miku/web/vendor (no van en git);
#   - las licencias de todo en /usr/share/licenses/vortex-miku/.
#
# NO trae el modelo 3D (los derechos del personaje no permiten subirlo a git: lo copia iso/construir.sh a
# /usr/share/vortex-miku/modelo/) ni los modelos de voz y de oído (~560 MB: la ISO no los carga; la app los
# baja la primera vez que se abre a Miku, con URL fija y sha256, a ~/.local/share/vortex/miku/).
#
#   cd packaging/vortex-miku && makepkg -si
pkgname=vortex-miku
pkgver=1.4.2
pkgrel=1
pkgdesc="Miku, la asistente de voz de Vortexine's OS: 3D, voz y oído locales, y Claude como cerebro (SUPER + O)"
arch=('any')
url='https://github.com/MikePianoXD777/vortex-os'
license=('MIT')
# pyside6 es Python + Qt; qt6-webengine (+ qt6-webchannel) dibuja el 3D, y no lo trae pyside6 aunque tenga los
# bindings; qt6-wayland, la ventana en Wayland; python-numpy y python-onnxruntime-cpu, la voz (Supertonic 3).
# NO python-onnxruntime: también lo proveen las variantes cuda y rocm, de varios GB. whisper-cpp es el oído
# (trae ffmpeg y ggml); pipewire trae pw-record (el micrófono) y pw-play (el altavoz).
depends=('python' 'pyside6' 'qt6-webengine' 'qt6-webchannel' 'qt6-wayland' 'python-numpy' 'python-onnxruntime-cpu'
         'whisper-cpp' 'pipewire')
optdepends=("claude-code: el cerebro de Miku (en Vortexine's se activa con «vortex claude activar»)"
            'libsecret: guarda la clave de ElevenLabs en el llavero (sin él, en un archivo 0600)')
source=("three-0.180.0.tgz::https://registry.npmjs.org/three/-/three-0.180.0.tgz"
        "three-vrm-3.5.5.tgz::https://registry.npmjs.org/@pixiv/three-vrm/-/three-vrm-3.5.5.tgz"
        "whisper.cpp-MIT.txt::https://raw.githubusercontent.com/ggml-org/whisper.cpp/v1.9.5/LICENSE")
# Los .tgz de npm meten todo bajo «package/»: se extraen a mano, cada uno en su carpeta.
noextract=("three-0.180.0.tgz" "three-vrm-3.5.5.tgz")
sha256sums=('ad66d724565ee29a2467277fa84daa5ed0211d6b8d446e9ef29f6bae0cd14144'
            '6f0102f987bc8abc9b9e78ef5b3259ea9f0dc51e30bf51d32aea6218394ea755'
            '94f29bbed6a22c35b992c5c6ebf0e7c92f13b836b90f36f461c9cf2f0f1d010d')

prepare() {
    cd "$srcdir"
    mkdir -p three three-vrm
    bsdtar -xf three-0.180.0.tgz -C three --strip-components=1
    bsdtar -xf three-vrm-3.5.5.tgz -C three-vrm --strip-components=1
}

package() {
    local origen="$startdir/../../apps/miku"
    local share="$pkgdir/usr/share/vortex-miku"
    local vendor="$share/web/vendor"

    install -d "$share" "$vendor/addons/loaders" "$vendor/addons/utils"
    cp -a "$origen/miku" "$origen/web" "$origen/persona" "$origen/licencias" "$origen/voces" "$share/"
    install -m644 "$origen/voces.json" "$share/voces.json"
    # Sin restos de ejecutar la app desde el repo.
    find "$share" -name '__pycache__' -type d -prune -exec rm -rf {} +

    # three.js y three-vrm: solo lo que usa la página (el mapa de importación está en web/index.html).
    install -m644 "$srcdir/three/build/three.module.min.js" "$srcdir/three/build/three.core.min.js" "$vendor/"
    install -m644 "$srcdir/three/examples/jsm/loaders/GLTFLoader.js" "$vendor/addons/loaders/"
    install -m644 "$srcdir/three/examples/jsm/utils/BufferGeometryUtils.js" \
                  "$srcdir/three/examples/jsm/utils/SkeletonUtils.js" "$vendor/addons/utils/"
    install -m644 "$srcdir/three-vrm/lib/three-vrm.module.min.js" "$vendor/"

    find "$share" -type d -exec chmod 755 {} +
    find "$share" -type f -exec chmod 644 {} +
    # Con el código ya compilado: /usr es de solo lectura para el usuario y, sin esto, Python
    # recompilaría todo en cada arranque.
    python -m compileall -q -s "$pkgdir" -p / "$share/miku"

    # El comando: la app lo reconoce instalado porque no hay miku/app.py junto a él.
    install -Dm755 "$origen/vortex-miku" "$pkgdir/usr/bin/vortex-miku"

    # Licencias: la del proyecto, la de la voz (BigScience OpenRAIL-M completa, con sus restricciones de
    # uso: hay que entregarla a quien reciba el modelo), la del motor de voz, la del oído y las del 3D.
    local lic="$pkgdir/usr/share/licenses/$pkgname"
    install -Dm644 "$startdir/../../LICENSE" "$lic/LICENSE"
    install -Dm644 "$origen/licencias/BigScience-OpenRAIL-M.txt" "$lic/BigScience-OpenRAIL-M.txt"
    install -Dm644 "$origen/licencias/supertonic-MIT.txt" "$lic/supertonic-MIT.txt"
    install -Dm644 "$origen/licencias/CREDITOS.txt" "$lic/CREDITOS.txt"
    install -Dm644 "$srcdir/whisper.cpp-MIT.txt" "$lic/whisper.cpp-MIT.txt"
    install -Dm644 "$srcdir/three/LICENSE" "$lic/three.js-MIT.txt"
    install -Dm644 "$srcdir/three-vrm/LICENSE" "$lic/three-vrm-MIT.txt"
}
