#!/usr/bin/python3
"""vortex-miku: Miku, la asistente de voz de Vortex OS (SUPER + O).

  vortex-miku                 abre a Miku y se pone a escuchar; si ya está abierta, la cierra del todo
  vortex-miku alternar        lo mismo
  vortex-miku avatar on|off   enciende o apaga el 3D (apagado queda solo el asistente de voz)
  vortex-miku estado          avatar=on|off y abierta=si|no
  vortex-miku modelo RUTA.vrm usa otro modelo 3D (un VRM)
  vortex-miku voz [ID]        sin ID lista las voces; con ID elige una (si hace falta, baja su archivito)
  vortex-miku licencias       créditos y licencias (el modelo 3D, la voz, el oído, three.js)
  vortex-miku preparar        baja ya la voz y el oído (~560 MB, una sola vez); si no, se bajan al abrirla
  vortex-miku decir "texto" [-o archivo.wav]   prueba la voz elegida (suena, o se guarda en un WAV)
  vortex-miku internet on|off|estado   deja a Miku buscar en la web y leer páginas (siempre con tu permiso)
  vortex-miku grabar [parar|estado]    graba la pantalla (una partida) en ~/Vídeos/Miku, o para la grabación
  vortex-miku momentos [VIDEO]         arma los mejores momentos (sin VIDEO, de la última grabación) como
                                       proyecto de Vortex Studio; Claude elige mirando miniaturas
  vortex-miku natural instalar   voz natural y expresiva, sin internet: en tu GPU NVIDIA serie 20+ de 6 GB
                                 (~7 GB) o, si no, en un procesador de 10.ª gen o más nuevo, lenta (~3 GB).
                                 Miku la instala sola la primera vez si tu PC aguanta; natural estado / quitar
  vortex-miku elevenlabs VOICE_ID   voz de ElevenLabs, en la nube (pide tu clave la primera vez)
  vortex-miku elevenlabs clave      cambia la clave · elevenlabs quitar: vuelve a la voz local (F1)
  vortex-miku ia [estado]           con qué IA piensa: claude (tu cuenta), local (en tu PC, sin cuenta ni
                                    internet), gemini u openai (con tu clave), u otra compatible con OpenAI
  vortex-miku ia local|gemini|openai [MODELO] · ia otra URL MODELO · ia claude   la cambia
  vortex-miku ia clave              pone la clave de la IA elegida · ia bajar: baja ya la IA local (~3,3 GB)

La configuración está en ~/.config/vortex/miku.json: {"avatar": true, "voz": "<id>", "modelo": "<ruta>"}.
Los modelos de la voz (Supertonic 3) y del oído (Whisper) no vienen en la ISO: la primera vez que se abre
a Miku se bajan a ~/.local/share/vortex/miku/{voz,oido}/ (con internet, y comprobados con sha256).
Cerrar a Miku termina la app y todos sus procesos (voz, oído, Claude): sin ella abierta no queda nada
corriendo. Solo usa la biblioteca estándar, así que arranca al instante.
"""

import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path


def _raiz() -> Path:
    """Donde está la app: apps/miku/ (desde el repo) o /usr/share/vortex-miku (instalada)."""
    if os.environ.get("VORTEX_MIKU_RAIZ"):
        return Path(os.environ["VORTEX_MIKU_RAIZ"])
    aqui = Path(__file__).resolve().parent
    return aqui if (aqui / "miku" / "app.py").is_file() else Path("/usr/share/vortex-miku")


RAIZ = _raiz()
sys.path.insert(0, str(RAIZ))
from miku import config, descargas, elevenlabs, grabacion, ia, rutas, voces  # noqa: E402  (solo biblioteca estándar)

APP = RAIZ / "miku" / "app.py"
MARCA_CMDLINE = "miku/app.py"          # para reconocer nuestro proceso por su línea de órdenes


def error(texto: str, codigo: int = 1) -> int:
    print(f"vortex-miku: {texto}", file=sys.stderr)
    return codigo


# ---- Procesos ------------------------------------------------------------------------------------

def _estado_proc(pid: int):
    """(ppid, pgrp, estado) de un proceso, o None si ya no existe."""
    try:
        resto = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return int(resto[1]), int(resto[2]), resto[0]
    except (OSError, IndexError, ValueError):
        return None


def _vivo(pid: int) -> bool:
    e = _estado_proc(pid)
    return e is not None and e[2] != "Z"


def _todos() -> dict[int, tuple[int, int, str]]:
    r = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            e = _estado_proc(int(d))
            if e:
                r[int(d)] = e
    return r


def _descendientes(pid: int, tabla=None) -> set[int]:
    tabla = tabla or _todos()
    hijos: dict[int, list[int]] = {}
    for p, (pp, _g, _s) in tabla.items():
        hijos.setdefault(pp, []).append(p)
    visto, pendientes = set(), [pid]
    while pendientes:
        for h in hijos.get(pendientes.pop(), []):
            if h not in visto:
                visto.add(h)
                pendientes.append(h)
    return visto


def _es_miku(pid: int) -> bool:
    try:
        return MARCA_CMDLINE in Path(f"/proc/{pid}/cmdline").read_text().replace("\0", " ")
    except OSError:
        return False


def pid_abierta() -> int | None:
    """El PID de la app abierta de este usuario, o None. Se comprueba que siga viva y sea Miku (no un PID reciclado)."""
    try:
        pid = int((rutas.runtime() / "vortex-miku.pid").read_text().strip())
    except (OSError, ValueError):
        return None
    return pid if _vivo(pid) and _es_miku(pid) else None


def cerrar_todo(pid: int) -> None:
    """Cierra la app y todo lo que lanzó (voz, oído, Claude y sus herramientas). Primero con calma, luego a la fuerza."""
    tabla = _todos()
    familia = _descendientes(pid, tabla)
    try:
        os.kill(pid, signal.SIGTERM)             # la app se despide sola: borra audios y la conversación
    except OSError:
        pass
    limite = time.monotonic() + 4.0
    while time.monotonic() < limite and _vivo(pid):
        time.sleep(0.05)
    # Barrido: lo que haya quedado vivo de la familia o del grupo de la app (que es una sesión propia).
    tabla = _todos()
    restos = {p for p in familia | {pid} if p in tabla and tabla[p][2] != "Z"}
    restos |= {p for p, (_pp, g, s) in tabla.items() if g == pid and s != "Z"}
    restos.discard(os.getpid())
    for senal, espera in ((signal.SIGTERM, 0.6), (signal.SIGKILL, 0.0)):
        for p in restos:
            try:
                os.kill(p, senal)
            except OSError:
                pass
        limite = time.monotonic() + espera
        while time.monotonic() < limite and any(_vivo(p) for p in restos):
            time.sleep(0.05)
        restos = {p for p in restos if _vivo(p)}
        if not restos:
            break
    for nombre in ("vortex-miku.pid",):
        try:
            (rutas.runtime() / nombre).unlink()
        except OSError:
            pass
    shutil.rmtree(rutas.runtime() / "vortex-miku", ignore_errors=True)    # audios temporales de la voz


def lanzar() -> int:
    """Abre la app, aparte de este comando: sesión propia, para poder cerrarla entera después."""
    registro = open(rutas.runtime() / "vortex-miku.log", "w")
    env = dict(os.environ)
    env.setdefault("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
    try:
        p = subprocess.Popen([sys.executable, "-I", str(APP)], stdin=subprocess.DEVNULL, stdout=registro, stderr=registro,
                             start_new_session=True, close_fds=True, env=env)
    except OSError as e:
        return error(f"no pude abrir a Miku ({e}).")
    (rutas.runtime() / "vortex-miku.pid").write_text(str(p.pid))
    time.sleep(0.5)
    if p.poll() is not None:
        try:
            cola = Path(rutas.runtime() / "vortex-miku.log").read_text().strip().splitlines()[-6:]
        except OSError:
            cola = []
        (rutas.runtime() / "vortex-miku.pid").unlink(missing_ok=True)
        return error("Miku se cerró al abrir. " + (" | ".join(cola) if cola else "Mira el registro en " + str(rutas.runtime() / "vortex-miku.log")))
    return 0


class Candado:
    """Un candado por usuario en $XDG_RUNTIME_DIR: dos pulsaciones seguidas no abren dos Mikus."""

    def __enter__(self):
        self.f = open(rutas.runtime() / "vortex-miku.lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


# ---- Órdenes -------------------------------------------------------------------------------------

def alternar() -> int:
    with Candado():
        pid = pid_abierta()
        if pid:
            cerrar_todo(pid)
            return 0
        return lanzar()


def reabrir_si_esta_abierta() -> bool:
    """Para que un cambio (avatar, voz, modelo) se vea ya: si Miku está abierta, la cierra y la abre de nuevo."""
    with Candado():
        pid = pid_abierta()
        if not pid:
            return False
        cerrar_todo(pid)
        lanzar()
        return True


def orden_avatar(args: list[str]) -> int:
    valores = {"on": True, "si": True, "sí": True, "true": True, "1": True, "off": False, "no": False, "false": False, "0": False}
    if len(args) != 1 or args[0].lower() not in valores:
        return error("uso: vortex-miku avatar on|off", 2)
    nuevo = valores[args[0].lower()]
    try:
        config.guardar({"avatar": nuevo})
    except OSError as e:
        return error(f"no pude guardar {rutas.CONFIG}: {e}")
    reabrir_si_esta_abierta()
    print(f"avatar={'on' if nuevo else 'off'}")
    return 0


