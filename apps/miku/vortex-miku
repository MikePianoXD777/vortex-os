#!/bin/sh
# vortex-miku: el lanzador mínimo. El comando de verdad es vortex-miku-rs (Rust, paquete vortex-rust); si no está
# instalado, o con VORTEX_MIKU_PYTHON=1, corre el de Python (vortex-miku-python, junto a este en el repo o en
# /usr/share/vortex-miku). Las órdenes natural y elevenlabs las atiende Python en los dos casos.
rs="${VORTEX_RUST_BIN:-/usr/lib/vortex}/vortex-miku-rs"
if [ -z "$VORTEX_MIKU_PYTHON" ] && [ -x "$rs" ]; then
    exec "$rs" "$@"
fi
aqui=$(dirname "$(readlink -f "$0")")
py="$aqui/vortex-miku-python"
[ -f "$py" ] || py=/usr/share/vortex-miku/vortex-miku-python
exec /usr/bin/python3 "$py" "$@"
