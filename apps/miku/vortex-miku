    if not voz_id or not all(c.isalnum() for c in voz_id):
        return error("ese no parece un Voice ID (son ~20 letras y números). Uso: vortex-miku elevenlabs VOICE_ID")
    clave = "" if cambiar_clave else elevenlabs.leer_clave()
    if not clave:
        clave = _pedir_clave()
        if not clave:
            return error("no escribiste ninguna clave.")
    try:
        nombre = _comprobar_elevenlabs(voz_id, clave)
    except elevenlabs.ErrorVoz as e:
        return error(str(e))
    donde = elevenlabs.guardar_clave(clave)
    config.guardar({"voz": "elevenlabs", "elevenlabs_voz": voz_id})
    print(f"Listo: Miku habla con «{nombre}» de ElevenLabs. La clave quedó en {'tu llavero' if donde == 'llavero' else donde}.")
    print("Pruébala con: vortex-miku decir \"[sighs] Hola... soy Miku.\"   (cada frase gasta créditos de tu cuenta)")
    if reabrir_si_esta_abierta():
        print("Miku estaba abierta: la volví a abrir con la voz nueva.")
    return 0


def _pedir_clave_ia(p: dict) -> str:
    import getpass
    print(f"Tu clave de {p['nombre']}: {p.get('donde') or 'la de tu servicio'}.")
    try:
        return getpass.getpass("Pégala aquí (no se ve al escribir) y Enter: ").strip()
    except (EOFError, OSError):
        return ""


def _bajar_ia_local(modelo: str) -> int:
    print(f"Bajando la IA local «{modelo}» (una sola vez, ~{ia.TAMANO_LOCAL})…")

    def progreso(detalle: str, fraccion: float) -> None:
        print(f"\r  {fraccion * 100:5.1f} %  {detalle}      ", end="", flush=True)
    try:
        ia.bajar_modelo(modelo, progreso=progreso)
    except ia.ErrorIA as e:
        print()
        return error(str(e))
    print("\nLista: Miku ya puede pensar en tu PC, sin internet.")
    return 0


def orden_ia(args: list[str]) -> int:
    cfg = config.cargar()
    p = ia.elegido(cfg)
    if not args or args[0] == "estado":
        print(f"ia={p['id']}")
        if p["id"] != "claude":
            print(f"  {p['nombre']}: modelo «{p['modelo'] or '(sin poner)'}» en {p['url'] or '(sin dirección)'}")
        if p.get("clave"):
            print(f"  clave: {'guardada' if ia.leer_clave(p['id']) else '(sin poner: vortex-miku ia clave)'}")
        if p["id"] == "local":
            if not ia.ollama_instalado():
                print("  falta Ollama: actualiza con «vortex actualizar»")
            # Ajustes lo consulta cada vez que se abre: aquí no se arranca Ollama, Miku lo arranca al usarlo.
            elif ia.ollama_corriendo():
                print(f"  modelo bajado: {'sí' if ia.modelo_local_listo(p['modelo']) else 'no (vortex-miku ia bajar)'}")
            else:
                print("  Ollama: apagado (Miku lo arranca cuando lo necesita)")
        print("Cámbiala con: vortex-miku ia claude|local|gemini|openai [MODELO]  ·  vortex-miku ia otra URL MODELO")
        return 0
    if args[0] == "clave":
        if p.get("clave") is False or p["id"] == "claude":
            return error(f"{p['nombre']} no usa clave.")
        clave = args[1] if len(args) > 1 else _pedir_clave_ia(p)
        if not clave:
            return error("no escribiste ninguna clave.")
        donde = ia.guardar_clave(p["id"], clave)
        print(f"Listo: la clave de {p['nombre']} quedó en {'tu llavero' if donde == 'llavero' else donde}.")
        reabrir_si_esta_abierta()
        return 0
    if args[0] == "bajar":
        return _bajar_ia_local(ia.elegido(dict(cfg, ia="local"))["modelo"])
    nuevo = args[0].lower()
    if nuevo not in config.IAS:
        return error("uso: vortex-miku ia claude|local|gemini|openai [MODELO] · ia otra URL MODELO · ia clave · ia bajar", 2)
    cambios = {"ia": nuevo, "ia_modelo": ""}
    if nuevo == "otra":
        if len(args) != 3 or not args[1].startswith(("http://", "https://")):
            return error("uso: vortex-miku ia otra URL MODELO   (p. ej. https://openrouter.ai/api/v1 un/modelo)", 2)
        cambios.update(ia_url=args[1], ia_modelo=args[2])
    elif len(args) > 1 and nuevo != "claude":
        cambios["ia_modelo"] = args[1]
    try:
        config.guardar(cambios)
    except OSError as e:
        return error(f"no pude guardar {rutas.CONFIG}: {e}")
    p = ia.elegido(dict(cfg, **cambios))
    print(f"ia={nuevo}: Miku piensa con {p['nombre']}" + (f" («{p['modelo']}»)." if nuevo != "claude" else "."))
    codigo = 0
    if p.get("clave") and not ia.leer_clave(nuevo):
        clave = _pedir_clave_ia(p) if sys.stdin.isatty() else ""
        if clave:
            ia.guardar_clave(nuevo, clave)
        else:
            print("Falta tu clave: ponla con «vortex-miku ia clave».")
    if nuevo == "local":
        if not ia.ollama_instalado():
            print("Falta Ollama: actualiza Vortexine's con «vortex actualizar» y vuelve a correr esto.")
        elif not ia.arrancar_ollama():
            codigo = error("no pude arrancar Ollama. Mira: systemctl --user status vortex-ollama")
        elif not ia.modelo_local_listo(p["modelo"]):
            codigo = _bajar_ia_local(p["modelo"])
    if reabrir_si_esta_abierta():
        print("Miku estaba abierta: la volví a abrir con la IA nueva.")
    return codigo


def orden_grabar(args: list[str]) -> int:
    que = args[0] if args else "empezar"
    try:
        if que == "estado":
            e = grabacion.grabando()
            print(f"grabando={'si' if e else 'no'}" + (f"\narchivo={e['archivo']}" if e else ""))
            return 0
        if que == "parar":
            archivo, segundos = grabacion.parar()
            print(f"Listo: {grabacion.duracion_texto(segundos)} en «{archivo}».")
            print("Sus mejores momentos: vortex-miku momentos")
            return 0
        if que != "empezar" or len(args) > 1:
            return error("uso: vortex-miku grabar [parar|estado]", 2)
        archivo = grabacion.empezar()
    except grabacion.ErrorGrabacion as e:
        return error(str(e))
    print(f"Grabando en «{archivo}». Para pararla: vortex-miku grabar parar")
    return 0


def orden_momentos(args: list[str]) -> int:
    if len(args) > 1:
        return error("uso: vortex-miku momentos [VIDEO]", 2)
    video = Path(os.path.expanduser(args[0])) if args else grabacion.ultima_grabacion()
    if video is None:
        return error(f"no hay grabaciones en {grabacion.carpeta_videos()}. Dime cuál: vortex-miku momentos VIDEO")
    from miku import momentos
    return momentos.main([str(video)])


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("alternar", "abrir", "toggle"):
        return alternar()
    orden, args = argv[0], argv[1:]
    if orden in ("-h", "--help", "ayuda"):
        print(__doc__.strip())
        return 0
    if orden == "avatar":
        return orden_avatar(args)
    if orden == "estado":
        return orden_estado()
    if orden == "internet":
        return orden_internet(args)
    if orden == "modelo":
        return orden_modelo(args)
    if orden == "voz":
        return orden_voz(args)
    if orden == "preparar":
        return orden_preparar()
    if orden in ("licencias", "creditos", "créditos"):
        try:
            print((rutas.LICENCIAS / "CREDITOS.txt").read_text(encoding="utf-8"))
        except OSError:
            return error("no encuentro el archivo de créditos. Reinstala vortex-miku.")
        return 0
    if orden == "decir":
        return orden_decir(args)
    if orden == "elevenlabs":
        return orden_elevenlabs(args)
    if orden == "natural":
        return orden_natural(args)
    if orden == "grabar":
        return orden_grabar(args)
    if orden == "momentos":
        return orden_momentos(args)
    if orden == "ia":
        return orden_ia(args)
    return error(f"no conozco «{orden}». Mira: vortex-miku ayuda", 2)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
