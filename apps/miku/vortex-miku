def orden_modelo(args: list[str]) -> int:
    if len(args) != 1:
        return error("uso: vortex-miku modelo RUTA.vrm", 2)
    origen = Path(os.path.expanduser(args[0]))
    try:
        with open(origen, "rb") as f:
            cabecera = f.read(12)
    except OSError as e:
        return error(f"no puedo leer «{origen}»: {e.strerror or e}")
    # Un VRM es un glTF binario (.glb): empieza con «glTF».
    if cabecera[:4] != b"glTF":
        return error(f"«{origen.name}» no parece un modelo VRM (un VRM empieza con «glTF»).")
    destino = rutas.MODELO_USUARIO
    credito_dest = destino.parent / "CREDITO.txt"
    credito_origen = origen.parent / "CREDITO.txt"
    try:
        destino.parent.mkdir(parents=True, exist_ok=True)
        mismo = destino.exists() and os.path.samefile(origen, destino)
        if not mismo:
            tmp = destino.with_name(destino.name + f".{os.getpid()}.tmp")
            shutil.copyfile(origen, tmp)
            os.replace(tmp, destino)
            if credito_origen.is_file():
                shutil.copyfile(credito_origen, credito_dest)
            else:
                credito_dest.unlink(missing_ok=True)       # el crédito de otro modelo no vale para este
    except OSError as e:
        return error(f"no pude copiar el modelo: {e}")
    if config.cargar_crudo().get("modelo"):
        config.guardar({"modelo": ""})                     # si no, ese "modelo" de miku.json taparía el nuevo
    print(f"Modelo listo: {destino}")
    if not mismo and not credito_origen.is_file():
        print("Aviso: no hay un CREDITO.txt junto al modelo. Respeta la licencia de su autor y ponle el crédito que pida.")
    if reabrir_si_esta_abierta():
        print("Miku estaba abierta: la volví a abrir con el modelo nuevo.")
    return 0


def orden_voz(args: list[str]) -> int:
    actual = config.cargar()["voz"]
    catalogo = voces.catalogo()
    if not args:
        print("Voces de Miku (la elegida lleva *):")
        for v in catalogo:
            if v.get("motor") == "qwen":
                estado = "lista" if voces.disponible(v) else "instálala con: vortex-miku natural instalar"
            elif v.get("motor") == "elevenlabs":
                estado = "lista" if voces.disponible(v) else "ponla con: vortex-miku elevenlabs VOICE_ID"
            elif v.get("incluida"):
                estado = "lista" if voces.disponible(v) else "se baja con el modelo la primera vez que abras a Miku"
            else:
                estado = "lista" if voces.disponible(v) else "se baja al elegirla (~290 KB)"
            print(f"{'*' if v['id'] == actual else ' '} {v['id']:<14} {v['nombre']}  [{estado}]")
            if v.get("descripcion"):
                print(f"    {v['descripcion']}")
        print("\nmiku-natural usa tu GPU o, lenta, tu CPU (Qwen3-TTS, Apache-2.0); las supertonic-* son locales en CPU\n"
              "(Supertonic 3, BigScience OpenRAIL-M); elevenlabs va por internet. Elige una con: vortex-miku voz ID")
        return 0
    if len(args) != 1:
        return error("uso: vortex-miku voz [ID]", 2)
    voz = voces.buscar(args[0])
    if voz is None:
        return error(f"no existe la voz «{args[0]}». Mira las que hay con: vortex-miku voz")
    if voz.get("motor") == "qwen" and not voces.disponible(voz):
        return error("la voz natural no está instalada. Instálala con: vortex-miku natural instalar")
    if voz.get("motor") == "elevenlabs" and not voces.disponible(voz):
        return error("para usar ElevenLabs primero pon tu voz y tu clave con: vortex-miku elevenlabs VOICE_ID")
    if not voz.get("incluida"):
        try:
            voces.descargar_estilo(voz, progreso=lambda t, f: None)
        except descargas.ErrorDescarga as e:
            return error(str(e))
    try:
        config.guardar({"voz": voz["id"]})
    except OSError as e:
        return error(f"no pude guardar {rutas.CONFIG}: {e}")
    print(f"Voz elegida: {voz['nombre']}")
    if not voces.modelo_listo():
        print("Aún no está bajado el modelo de voz: se baja la primera vez que abras a Miku (o ya, con: vortex-miku preparar).")
    if reabrir_si_esta_abierta():
        print("Miku estaba abierta: la volví a abrir con la voz nueva.")
    return 0


def orden_preparar() -> int:
    """Baja la voz y el oído ya, mostrando el progreso en la terminal (la app hace lo mismo sola al abrirse)."""
    faltan = descargas.pendientes()
    if not faltan:
        print("La voz y el oído de Miku ya están listos.")
        return 0
    print(f"Preparando la voz de Miku (una sola vez, {descargas.TAMANO_TOTAL_TEXTO if len(faltan) == len(descargas.paquetes()) else descargas.megas(descargas.bytes_pendientes(faltan))})…")
    d = descargas.Descarga(faltan, progreso=lambda t, f: print(f"\r  {f:4.0%}  {t}   ", end="", flush=True))
    try:
        d.correr()
    except descargas.ErrorDescarga as e:
        print()
        return error(str(e))
    except KeyboardInterrupt:
        print()
        return error("descarga cancelada; lo bajado se conserva y sigue donde se quedó la próxima vez.", 130)
    print("\nListo: la voz y el oído de Miku están en", rutas.DATOS)
    return 0


def orden_decir(args: list[str]) -> int:
    salida = None
    if "-o" in args:
        i = args.index("-o")
        if i + 1 >= len(args):
            return error("uso: vortex-miku decir \"texto\" [-o archivo.wav]", 2)
        salida = args[i + 1]
        args = args[:i] + args[i + 2:]
    texto = " ".join(args).strip()
    if not texto:
        return error("uso: vortex-miku decir \"texto\" [-o archivo.wav]", 2)
    cfg = config.cargar()
    motor = (voces.buscar(cfg["voz"]) or {}).get("motor")
    if motor == "qwen" and not voces.disponible(voces.buscar(cfg["voz"])):
        return error("la voz natural no está instalada. Instálala con: vortex-miku natural instalar")
    if motor not in ("elevenlabs", "qwen") and not voces.modelo_listo():
        return error("el modelo de voz aún no está bajado. Bájalo con: vortex-miku preparar")
    destino = salida or str(rutas.temporales() / f"decir-{os.getpid()}.wav")
    if motor == "qwen":
        r = subprocess.run([str(rutas.NATURAL_PYTHON), "-I", str(RAIZ / "miku" / "voz_natural.py"), "--voz", cfg["voz"],
                            "--salida", destino, texto], env={**os.environ, "HF_HUB_OFFLINE": "1"})
    else:
        r = subprocess.run([sys.executable, "-I", str(RAIZ / "miku" / "voz_worker.py"), "--voz", cfg["voz"],
                            "--estilo", "miku" if cfg["avatar"] else "normal", "--salida", destino, texto])
    if r.returncode != 0:
        return r.returncode
    if salida:
        print(f"Listo: {salida}")
        return 0
    try:
        for reproductor in (["pw-play"], ["paplay"], ["aplay", "-q"]):
            if shutil.which(reproductor[0]):
                subprocess.run(reproductor + [destino])
                break
        else:
            return error("no encuentro con qué reproducir sonido (pw-play).")
    finally:
        Path(destino).unlink(missing_ok=True)
    return 0


# ---- Voz natural (Qwen3-TTS en la GPU o, lenta, en la CPU) -----------------------------------------

# Versiones probadas juntas (PyTorch lo trae faster-qwen3-tts; transformers 5.20 rompe su parche de Mimi).
NATURAL_PAQUETES = ["faster-qwen3-tts==0.5.4", "transformers==5.15.1", "setuptools<81"]
NATURAL_GIB_MIN = 6.0           # VRAM: el modelo 1.7B usa ~5 GB
NATURAL_CC_MIN = 7.5            # serie 20 (Turing) o más nueva: el PyTorch con CUDA 13 ya no trae las Pascal (GTX 10)
# Modo CPU (sin una GPU que sirva): el backend ggml de faster-qwen3-tts (qwentts.cpp) con el modelo 0.6B en Q4_K_M.
# faster-qwen3-tts importa PyTorch igual, así que va el de CPU (~0,8 GB en vez de ~6 GB con CUDA). La rueda de
# qwentts.cpp de PyPI viene compilada con CUDA (pide libcudart, libcublas y el driver de NVIDIA aunque no use la
# GPU): se usa la de CPU que su autor publica en Hugging Face, fijada a un commit y comprobada con sha256.
NATURAL_INDICE_TORCH_CPU = "https://download.pytorch.org/whl/cpu"
NATURAL_TORCH_CPU = ["torch==2.14.1", "torchaudio==2.11.0"]
NATURAL_QWENTTS_CPU = ("qwentts-cpp-python @ https://huggingface.co/datasets/andito/qwentts-cpp-python-wheels/resolve/"
                       "c7d8345b0ec4773a64976f322bcd0947d81a205a/whl/cpu/"
                       "qwentts_cpp_python-0.5.0%2Bcpu-py3-none-manylinux_2_35_x86_64.whl"
                       "#sha256=71aefbc34908503cef086dfef2e2549a03d9a0303c50a82562308019e3a9a77d")
NATURAL_PAQUETES_CPU = NATURAL_PAQUETES + [NATURAL_QWENTTS_CPU]
# Modo CUDA (NVIDIA de la serie 10 o una de 4-5 GB, donde el PyTorch de la GPU no corre): el mismo modelo 1.7B
# que en modo GPU (la misma voz), cuantizado en GGUF, con qwentts.cpp en la GPU. Ninguna rueda publicada trae las
# Pascal (sm_61): Vortex publica su propia compilación de qwentts.cpp (el commit que espera la rueda 0.5.0, con
# CUDA 12.9 para sm_61 y sm_86), fijada con sha256. CUDA 12 (runtime y cuBLAS) llega con pip.
NATURAL_CC_MIN_CUDA = 6.1       # GTX 10 (Pascal)
NATURAL_GIB_MIN_CUDA = 4.0      # el 1.7B en Q4_K_M ocupa ~4,1 GB de VRAM; en Q8_0 ~4,9 GB
NATURAL_GIB_Q8 = 7.5            # con 8 GB o más, Q8_0 (la más parecida a la de modo GPU); con menos, Q4_K_M
NATURAL_PAQUETES_CUDA = NATURAL_PAQUETES_CPU + ["nvidia-cuda-runtime-cu12==12.9.79", "nvidia-cublas-cu12==12.9.2.10"]
NATURAL_LIBS_CUDA = {
    "url": os.environ.get("VORTEX_MIKU_QWENTTS_CUDA_URL") or
           "https://github.com/MikePianoXD777/vortex-os/releases/download/miku-qwentts-cuda-1/"
           "vortex-miku-qwentts-cuda-1.tar.gz",
    "sha256": os.environ.get("VORTEX_MIKU_QWENTTS_CUDA_SHA256") or "62bde96dcdfb7a4c9b58189a63aaca46d5a886b8b7342c350c2f8dfab907f523",
}
# Las bibliotecas de CUDA 12 que pide libggml-cuda: enlaces junto a ella, a las que puso pip en el entorno.
NATURAL_CUDA_ENLACES = {"libcudart.so.12": "cuda_runtime", "libcublas.so.12": "cublas", "libcublasLt.so.12": "cublas"}


def gpu_para_natural() -> tuple[bool, str]:
    """¿Hay una GPU NVIDIA que aguante la voz natural? (sí/no, explicación)."""
    if not shutil.which("nvidia-smi"):
        return False, "no encuentro una GPU NVIDIA con su driver (nvidia-smi)."
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=name,compute_cap,memory.total", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False, "nvidia-smi no respondió."
    mejor = None
    for linea in r.stdout.strip().splitlines():
        try:
            nombre, cc, mem = [x.strip() for x in linea.split(",")]
            cc_f, gib = float(cc), float(mem) / 1024
        except ValueError:
            continue
        if mejor is None or (cc_f >= NATURAL_CC_MIN and gib > mejor[2]):
            mejor = (nombre, cc_f, gib)
    if mejor is None:
        return False, "no pude leer tu GPU con nvidia-smi."
    nombre, cc_f, gib = mejor
    if cc_f < NATURAL_CC_MIN:
        return False, f"tu {nombre} es muy vieja para la voz natural (hace falta una serie 20 o más nueva)."
    if gib < NATURAL_GIB_MIN:
        return False, f"tu {nombre} tiene {gib:.0f} GB y la voz natural necesita {NATURAL_GIB_MIN:.0f} GB."
    return True, f"{nombre} ({gib:.0f} GB)"


def gpu_vieja_para_natural() -> tuple[bool, str, str]:
    """¿Hay una NVIDIA que aguante la voz natural en modo CUDA (qwentts.cpp)? (sí/no, explicación, cuantización)."""
    if not shutil.which("nvidia-smi"):
        return False, "no hay una GPU NVIDIA con su driver.", ""
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=name,compute_cap,memory.total", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False, "nvidia-smi no respondió.", ""
    mejor = None
    for linea in r.stdout.strip().splitlines():
        try:
            nombre, cc, mem = [x.strip() for x in linea.split(",")]
            cc_f, gib = float(cc), float(mem) / 1024
        except ValueError:
            continue
        if cc_f >= NATURAL_CC_MIN_CUDA and (mejor is None or gib > mejor[1]):
            mejor = (nombre, gib)
    if mejor is None:
        return False, "tu GPU NVIDIA es más vieja que la serie 10.", ""
    nombre, gib = mejor
    if gib < NATURAL_GIB_MIN_CUDA - 0.1:
        return False, f"tu {nombre} tiene {gib:.0f} GB y hacen falta {NATURAL_GIB_MIN_CUDA:.0f} GB.", ""
    return True, f"{nombre} ({gib:.0f} GB)", "Q8_0" if gib >= NATURAL_GIB_Q8 else "Q4_K_M"


NATURAL_RAM_CPU_GIB = 7.0       # en la CPU ocupa ~4 GB mientras Miku está abierta: hace falta una PC de 8 GB


def generacion_cpu(nombre: str) -> tuple[bool, str] | None:
    """¿El procesador es de 10.ª generación de Intel (o un Ryzen 3000 de escritorio) o más nuevo? None si no se sabe.

    Es la vara de Mike: en un i7-10700F la voz natural va lenta pero se puede platicar; más viejo, ya no.
    """
    n = " ".join(nombre.replace("(TM)", " ").replace("(R)", " ").split())
    if re.search(r"\bCore Ultra\b|\bCore [357] \d{3}[A-Z]*\b", n):           # Core Ultra y la serie 100 (2023+)
        return True, "Intel Core de 2023 o más nuevo"
    m = re.search(r"\bCore i[3579]-(\d{4,5})", n)
    if m:
        cifras = m.group(1)
        # i7-10700F, i9-11900K (5 cifras) y las de laptop i7-1065G7, i5-1135G7, i5-1235U (4 cifras que empiezan
        # con 1: ninguna de la 2.ª a la 9.ª empieza así)
        gen = int(cifras[:2]) if len(cifras) == 5 or cifras[0] == "1" else int(cifras[0])
        return gen >= 10, f"Intel Core de {gen}.ª generación"
    if re.search(r"\bRyzen AI\b|\bRyzen Z\d", n):
        return True, "Ryzen de 2023 o más nuevo"
    m = re.search(r"\bRyzen (?:Threadripper )?(?:\d )?(?:PRO )?(\d)\d{3}([A-Z]*)", n)
    if m:
        serie, sufijo = int(m.group(1)), m.group(2)
        # Los 3000 de escritorio son Zen 2; los 3000 G, U y H son Zen+ (como los 2000).
        return (serie >= 4 or (serie == 3 and sufijo in ("", "X", "XT", "WX"))), f"Ryzen serie {serie}000"
    return None


def cpu_para_natural() -> tuple[bool, str]:
    """¿El procesador aguanta la voz natural (lenta)? (sí/no, explicación)."""
    nombre = ""
    try:
        for linea in Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="replace").splitlines():
            if linea.startswith("model name"):
                nombre = linea.split(":", 1)[1].strip()
                break
    except OSError:
        pass
    ram = 0.0
    try:
        for linea in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if linea.startswith("MemTotal:"):
                ram = int(linea.split()[1]) / 1024 / 1024
                break
    except (OSError, ValueError, IndexError):
        pass
    if not nombre:
        return False, "no pude leer qué procesador tienes."
    gen = generacion_cpu(nombre)
    if gen is None or not gen[0]:
        return False, (f"tu {nombre} no llega: en la CPU hace falta un Intel Core de 10.ª generación o más nuevo, "
                       "o un Ryzen 3000 o más nuevo.")
    if ram and ram < NATURAL_RAM_CPU_GIB:
        return False, f"tienes {ram:.0f} GB de RAM y la voz natural en la CPU necesita 8 GB."
    return True, f"{nombre} ({gen[1]})"


def elegir_modo(args: list[str]) -> tuple[str, str]:
    """(«gpu», «cuda», «cpu» o «», por qué). Una NVIDIA serie 20+ con 6 GB: gpu. Una NVIDIA serie 10+ con 4 GB:
    cuda (la misma voz, con qwentts.cpp). Si no, un procesador de 10.ª generación o más nuevo: cpu (lenta). Si
    tampoco, «»: Miku se queda con la voz de siempre. --cpu y --cuda fuerzan su modo."""
    ok, gpu = gpu_para_natural()
    if "--cpu" in args:
        return "cpu", "Pediste el modo CPU."
    if "--cuda" in args:
        return "cuda", "Pediste el modo CUDA."
    if ok or "--sin-revisar" in args:
        return "gpu", f"GPU: {gpu}."
    ok_cuda, vieja, _ = gpu_vieja_para_natural()
    if ok_cuda:
        return "cuda", f"GPU: {vieja}, con qwentts.cpp."
    ok_cpu, cpu = cpu_para_natural()
    if ok_cpu:
        return "cpu", f"GPU: no sirve ({gpu.rstrip('.')}). Procesador: {cpu}."
    return "", f"GPU: no sirve ({gpu.rstrip('.')}). Procesador: {cpu}"


def bajar_libs_cuda() -> int:
    """Baja la compilación de qwentts.cpp con CUDA (comprobada con sha256) a NATURAL/cuda y la enlaza con el
    CUDA 12 que puso pip. 0 si quedó lista."""
    import hashlib
    import tarfile
    import urllib.request
    destino = rutas.NATURAL / "cuda"
    archivo = rutas.NATURAL / "qwentts-cuda.tar.gz"
    try:
        with urllib.request.urlopen(NATURAL_LIBS_CUDA["url"], timeout=60) as r, open(archivo, "wb") as f:
            shutil.copyfileobj(r, f, 1 << 20)
        h = hashlib.sha256()
        with open(archivo, "rb") as f:
            for trozo in iter(lambda: f.read(1 << 20), b""):
                h.update(trozo)
        if h.hexdigest() != NATURAL_LIBS_CUDA["sha256"]:
            print("La descarga no coincide con su sha256: no la uso.", file=sys.stderr)
            return 1
        shutil.rmtree(destino, ignore_errors=True)
        nuevo = rutas.NATURAL / "cuda.nuevo"
        shutil.rmtree(nuevo, ignore_errors=True)
        nuevo.mkdir(parents=True)
        with tarfile.open(archivo) as tar:
            for m in tar.getmembers():          # solo archivos sueltos, sin carpetas ni enlaces
                if m.isfile() and "/" not in m.name.strip("./") and not m.name.startswith("/"):
                    m.name = Path(m.name).name
                    tar.extract(m, nuevo, filter="data")
        if not (nuevo / "libqwen.so").is_file():
            print("La descarga no trae libqwen.so.", file=sys.stderr)
            return 1
        sitio = next((rutas.NATURAL / "venv" / "lib").glob("python3*/site-packages"), None)
        for nombre, paquete in NATURAL_CUDA_ENLACES.items():
            real = sitio / "nvidia" / paquete / "lib" / nombre if sitio else None
            if real is None or not real.exists():
                print(f"Falta {nombre} (pip no puso CUDA 12).", file=sys.stderr)
                return 1
            # Relativo: si la carpeta se mueve, sigue sirviendo.
            (nuevo / nombre).symlink_to(os.path.relpath(real, destino))
        nuevo.rename(destino)
        return 0
    except (OSError, tarfile.TarError) as e:
        print(f"No pude bajar qwentts.cpp: {e}", file=sys.stderr)
        return 1
    finally:
        archivo.unlink(missing_ok=True)


def mejorar_natural() -> int:
    """Si la voz natural quedó en la CPU (la 0.6B, lenta y menos natural) pero la GPU sí sirve (GPU o, desde la 1.7,
    las NVIDIA serie 10 en modo cuda), la rehace con la voz 1.7B de las GPU. La ventana de Miku la lanza sola. Se
    arma en otra carpeta y se cambia al final: mientras, Miku sigue hablando con la de antes."""
    voz = voces.buscar("miku-natural")
    if voz is None or not voces.disponible(voz) or voces.modo_natural() != "cpu" or not config.cargar()["voz_natural_auto"]:
        print("No hace falta: la voz natural no está en modo CPU.")
        return 0
    modo, porque = elegir_modo([])
    if modo not in ("gpu", "cuda"):
        print(f"No hace falta: la GPU no sirve. {porque}")
        return 0
    actual = rutas.NATURAL
    nueva = actual.with_name(actual.name + "-nueva")
    nombres = ("NATURAL", "NATURAL_PYTHON", "NATURAL_LISTO", "NATURAL_MODO", "NATURAL_CUANT")
    antes = {n: getattr(rutas, n) for n in nombres}
    for n in nombres:
        setattr(rutas, n, nueva / antes[n].relative_to(actual) if n != "NATURAL" else nueva)
    try:
        print(f"{time.strftime('%F %T')} la voz natural está en la CPU y tu GPU sí sirve: la rehago en modo "
              f"{modo.upper()}.", flush=True)
        rc = orden_natural(["instalar", "--auto", "--nueva"])
        listo = rutas.NATURAL_LISTO.is_file()
    finally:
        for n, valor in antes.items():
            setattr(rutas, n, valor)
    if rc != 0 or not listo:
        return rc or 1
    vieja = actual.with_name(actual.name + "-vieja")
    shutil.rmtree(vieja, ignore_errors=True)
    actual.rename(vieja)
    nueva.rename(actual)
    shutil.rmtree(vieja, ignore_errors=True)
    print("Listo: la voz natural ya va en la GPU; Miku la usa la próxima vez que la abras.")
    subprocess.run(["notify-send", "-a", "Miku", "-i", "vortex-miku", "Miku mejoró su voz natural",
                    "Ahora va en tu GPU: la usa la próxima vez que la abras (Super+O)."], capture_output=True, check=False)
    return 0


def orden_natural(args: list[str]) -> int:
    voz = voces.buscar("miku-natural")
    if voz is None:
        return error("esta versión de Miku no trae la voz natural.")
    orden = args[0] if args else "estado"
    if orden == "estado":
        ok, gpu = gpu_para_natural()
        modo, _ = elegir_modo([])
        instalada = voces.disponible(voz)
        print(f"Voz natural de Miku: {'instalada' if instalada else 'sin instalar'}"
              f"{' y en uso' if config.cargar()['voz'] == 'miku-natural' else ''}.")
        if instalada:
            print("  Modo: " + {"gpu": "GPU", "cuda": f"GPU con qwentts.cpp ({voces.cuantizacion_natural()})"}.get(
                voces.modo_natural(), "CPU (lento: cada frase tarda unos 6 s más lo que dura)"))
        print(f"  GPU: {gpu if ok else 'no sirve: ' + gpu}")
        if not ok and modo == "cuda":
            print(f"  Pero sirve con qwentts.cpp: {gpu_vieja_para_natural()[1]}")
        elif not ok:
            ok_cpu, cpu = cpu_para_natural()
            print(f"  Procesador: {cpu if ok_cpu else 'no sirve: ' + cpu}")
        if not instalada:
            if modo:
                print("  Instálala con: vortex-miku natural instalar   " + {
                    "gpu": "(~7 GB, una sola vez)", "cuda": "(~4 GB, una sola vez)"}.get(
                    modo, "(en la CPU, lenta; ~3 GB, una sola vez)"))
                if config.cargar()["voz_natural_auto"]:
                    print("  (Miku la instala sola en segundo plano la próxima vez que la abras.)")
            else:
                print("  Tu PC no aguanta la voz natural: Miku habla con la de siempre.")
        return 0
    if orden == "quitar":
        shutil.rmtree(rutas.NATURAL, ignore_errors=True)
        cambios = {"voz_natural_auto": False}       # que Miku no la vuelva a instalar sola
        if config.cargar()["voz"] == "miku-natural":
            cambios["voz"] = voces.VOZ_DEFECTO
        config.guardar(cambios)
        print("Listo: borré la voz natural; Miku vuelve a la voz de siempre (F1).")
        reabrir_si_esta_abierta()
        return 0
    if orden == "mejorar":
        return mejorar_natural()
    if orden != "instalar" or any(a not in ("--cpu", "--cuda", "--sin-revisar", "--auto", "--nueva") for a in args[1:]):
        return error("uso: vortex-miku natural [estado|instalar [--cpu|--cuda]|quitar]", 2)
    # --auto: lo lanza la ventana de Miku en segundo plano (ver asistente.py). Solo instala si nadie eligió otra
    # voz ni la quitó, y una sola a la vez; al terminar avisa con una notificación y no reabre a Miku.
    auto = "--auto" in args
    if auto:
        cfg = config.cargar()
        # --nueva: la rehace mejorar_natural en otra carpeta, con la voz natural ya elegida.
        if voces.disponible(voz) or not cfg["voz_natural_auto"] or (cfg["voz"] != voces.VOZ_DEFECTO
                                                                    and "--nueva" not in args):
            print("No hace falta: la voz natural ya está, la quitaste o elegiste otra voz.")
            return 0
        rutas.NATURAL.mkdir(parents=True, exist_ok=True)
        candado = open(rutas.NATURAL / "instalando.lock", "w")      # se suelta al salir
        try:
            fcntl.flock(candado, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("Ya se está instalando.")
            return 0
    modo, porque = elegir_modo(args)
    if not modo and auto:
        print(f"Tu PC no aguanta la voz natural: Miku sigue con la de siempre. {porque}")
        return 0
    if auto:
        print(f"{time.strftime('%F %T')} instalación automática ({modo.upper()}). {porque}", flush=True)
        subprocess.run(["notify-send", "-a", "Miku", "-i", "vortex-miku", "Miku está preparando su voz natural",
                        "Una sola vez (" + {"gpu": "~7 GB", "cuda": "~4 GB"}.get(modo, "~3 GB, en el procesador: será lenta")
                        + "). Mientras, habla con la de siempre."], capture_output=True, check=False)
    if not modo:
        return error(f"tu PC no aguanta la voz natural. {porque}\nMiku sigue con la voz de siempre. Si igual la "
                     "quieres (muy lenta): vortex-miku natural instalar --cpu")
    if modo == "gpu":
        print(f"{porque} Instalo la voz natural en {rutas.NATURAL} (PyTorch ~3 GB + el modelo ~4 GB; una sola vez).")
    elif modo == "cuda":
        print(f"{porque} Instalo la voz natural en {rutas.NATURAL}\n(PyTorch de CPU, CUDA 12 y qwentts.cpp ~2,5 GB "
              "+ el modelo ~1,5-2,5 GB; una sola vez). Es la misma voz que en las GPU nuevas.")
    else:
        print(f"{porque} Instalo la voz natural en la CPU, en {rutas.NATURAL}\n(PyTorch de CPU y lo demás ~2 GB + el "
              "modelo ~0,9 GB; una sola vez).")
        print("Ojo: en la CPU es lenta. Cada frase tarda en salir unos 6 s más lo que dura (en un i7 de 8 núcleos),\n"
              "así que Miku tarda más en contestar.")
    rutas.NATURAL.mkdir(parents=True, exist_ok=True)
    rutas.NATURAL_LISTO.unlink(missing_ok=True)
    if voces.modo_natural() != modo and (rutas.NATURAL / "venv").exists():
        # El PyTorch de un modo no sirve para el otro (el de CPU no trae CUDA) y los modelos son otros.
        print(f"Estaba instalada en modo {voces.modo_natural().upper()}: la rehago para {modo.upper()}.")
        for d in ("venv", "hf", "referencias", "cuda"):
            shutil.rmtree(rutas.NATURAL / d, ignore_errors=True)
    rutas.NATURAL_MODO.write_text(modo + "\n", encoding="utf-8")
    cuant = voz["cuantizacion_cpu"]
    if modo == "cuda":
        ok_cuda, _, cuant = gpu_vieja_para_natural()
        cuant = cuant or "Q4_K_M"                       # con --cuda y una GPU que no se pudo leer
        if voces.cuantizacion_natural() != cuant:
            shutil.rmtree(rutas.NATURAL / "referencias", ignore_errors=True)    # la muestra procesada es del modelo
        rutas.NATURAL_CUANT.write_text(cuant + "\n", encoding="utf-8")
    venv_py = rutas.NATURAL_PYTHON
    pip = [str(venv_py), "-m", "pip", "install", "--disable-pip-version-check", "--progress-bar", "on"]
    pasos = []
    if not venv_py.is_file():
        pasos.append(("Creando su entorno de Python", [sys.executable, "-m", "venv", str(rutas.NATURAL / "venv")]))
    if modo == "gpu":
        pasos += [
            ("Instalando PyTorch y Qwen3-TTS", pip + NATURAL_PAQUETES),
            ("Bajando el modelo de la voz", [str(venv_py), "-I", "-c",
                                            "import sys; from huggingface_hub import snapshot_download; "
                                            "snapshot_download(sys.argv[1], cache_dir=sys.argv[2])",
                                            voz["modelo"], str(rutas.NATURAL / "hf")]),
        ]
    else:
        pasos += [
            # Primero el PyTorch de CPU: así faster-qwen3-tts lo da por puesto y no baja el de CUDA.
            ("Instalando PyTorch (CPU)", pip + ["--index-url", NATURAL_INDICE_TORCH_CPU, *NATURAL_TORCH_CPU]),
            ("Instalando Qwen3-TTS y qwentts.cpp" + (" con CUDA 12" if modo == "cuda" else ""),
             pip + (NATURAL_PAQUETES_CUDA if modo == "cuda" else NATURAL_PAQUETES_CPU)),
        ]
        if modo == "cuda":
            pasos.append(("Bajando qwentts.cpp para tu GPU", bajar_libs_cuda))
        pasos.append(("Bajando el modelo de la voz", [str(venv_py), "-I", "-c",
                                                     "import sys; from qwentts_cpp.models import resolve_gguf_paths; "
                                                     "resolve_gguf_paths(sys.argv[1], quant=sys.argv[2], cache_dir=sys.argv[3])",
                                                     voz["modelo" if modo == "cuda" else "modelo_cpu"], cuant,
                                                     str(rutas.NATURAL / "hf")]))
    for titulo, cmd in pasos:
        print(f"\n==> {titulo}…", flush=True)
        if (cmd() if callable(cmd) else subprocess.run(cmd).returncode) != 0:
            forzado = " --cpu" if "--cpu" in args else " --cuda" if "--cuda" in args else ""
            return error(f"falló «{titulo}». Lo bajado se conserva: vuelve a correr «vortex-miku natural instalar"
                         f"{forzado}».")
    print("\n==> Probando la voz…" + (" (en la CPU tarda unos 20 s)" if modo == "cpu" else ""), flush=True)
    prueba = rutas.temporales() / f"natural-{os.getpid()}.wav"
    r = subprocess.run([str(venv_py), "-I", str(RAIZ / "miku" / "voz_natural.py"), "--salida", str(prueba),
                        "Hola... ya estoy lista."], env={**os.environ, "HF_HUB_OFFLINE": "1"})
    if r.returncode != 0 or not prueba.is_file():
        return error("la voz natural se instaló pero no pudo hablar. Mira el mensaje de arriba.")
    prueba.unlink(missing_ok=True)
    if modo == "gpu":
        rutas.NATURAL_LISTO.write_text(" ".join(NATURAL_PAQUETES) + f"\n{voz['modelo']}\n", encoding="utf-8")
    elif modo == "cuda":
        rutas.NATURAL_LISTO.write_text(" ".join(NATURAL_TORCH_CPU + NATURAL_PAQUETES_CUDA)
                                       + f"\n{NATURAL_LIBS_CUDA['sha256']}\n{voz['modelo']} {cuant}\n", encoding="utf-8")
    else:
        rutas.NATURAL_LISTO.write_text(" ".join(NATURAL_TORCH_CPU + NATURAL_PAQUETES_CPU)
                                       + f"\n{voz['modelo_cpu']} {voz['cuantizacion_cpu']}\n", encoding="utf-8")
    if "--nueva" in args:
        return 0
    if auto and config.cargar()["voz"] != voces.VOZ_DEFECTO:
        print("\nListo, pero mientras tanto elegiste otra voz: la dejo como está (vortex-miku voz miku-natural la cambia).")
        return 0
    config.guardar({"voz": "miku-natural"})
    if auto:
        print("\nListo: Miku ya tiene su voz natural; la usa la próxima vez que la abras.")
        subprocess.run(["notify-send", "-a", "Miku", "-i", "vortex-miku", "Miku ya tiene su voz natural",
                        "La usa la próxima vez que la abras (Super+O)."], capture_output=True, check=False)
        return 0
    if modo in ("gpu", "cuda"):
        print("\nListo: Miku ya habla con su voz natural. Solo usa la GPU mientras Miku está abierta.")
    else:
        print("\nListo: Miku ya habla con su voz natural, en la CPU (modo lento). Solo ocupa memoria (~4 GB) "
              "mientras Miku está abierta.")
    print("Pruébala con: vortex-miku decir \"Hola... ¿cómo estás?\"")
    if reabrir_si_esta_abierta():
        print("Miku estaba abierta: la volví a abrir con la voz nueva.")
    return 0


def _comprobar_elevenlabs(voz_id: str, clave: str) -> str:
    """Revisa la clave y la voz sin gastar créditos (GET de la voz). Devuelve el nombre de la voz."""
    import json
    import urllib.error
    import urllib.request
    req = urllib.request.Request(f"{elevenlabs.API}/voices/{urllib.request.quote(voz_id, safe='')}", headers={"xi-api-key": clave})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read() or b"{}").get("name", "") or voz_id
    except urllib.error.HTTPError as e:
        raise elevenlabs.ErrorVoz(elevenlabs._explicar(e.code, e.read())) from None
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise elevenlabs.ErrorVoz(f"No pude llegar a ElevenLabs (¿sin internet?): {getattr(e, 'reason', e)}") from None


