# La IA local de Miku («vortex-miku ia local»): Ollama para tu usuario, solo en 127.0.0.1, con los
# modelos en ~/.ollama. No arranca sola: la levanta Miku cuando la necesita. Usa la GPU por Vulkan
# (NVIDIA, AMD o Intel; si no hay, la CPU) y suelta el modelo de la GPU tras 10 min sin usarse.
[Unit]
Description=IA local de Miku (Ollama)

[Service]
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_VULKAN=1
Environment=OLLAMA_KEEP_ALIVE=10m
# Contexto de 8K: con 4K una plática corta ya corta las instrucciones de Miku (ver ia.py, CONTEXTO_LOCAL)
Environment=OLLAMA_CONTEXT_LENGTH=8192
# Una plática a la vez y un solo modelo cargado: con paralelismo automático el contexto se multiplica en
# la VRAM y en una GPU de 4-6 GB (GTX 1060) ya no cabe junto con la voz.
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Nice=10
ExecStart=/usr/bin/ollama serve
Restart=on-failure
RestartSec=3
