#!/usr/bin/env bash
# Vortexine's Camera: tus cámaras de seguridad (Imou/Dahua) en mosaico.
#   vortex-camera
# Corre «python -m vortex_camera» con el código donde esté:
#   1. VORTEX_CAMERA_DIR, si la defines (para probar otra copia);
#   2. la carpeta de este mismo archivo (el repo, o ~/.local/share/vortex-camera, donde la deja
#      «vortex camara instalar»).
set -euo pipefail

aqui="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
raiz=""
for candidato in "${VORTEX_CAMERA_DIR:-}" "$aqui"; do
  if [[ -n "$candidato" && -f "$candidato/vortex_camera/__init__.py" ]]; then
    raiz="$candidato"
    break
  fi
done
if [[ -z "$raiz" ]]; then
  echo "Vortexine's Camera no está instalada del todo: instálala con «vortex camara instalar»." >&2
  exit 1
fi

# 4.0: si está la versión en Rust (paquete vortex-rust), se usa esa: misma ventana (los QML de esta misma
# carpeta), menos memoria. VORTEX_CAMERA_PYTHON=1 obliga a usar la de Python.
rust_bin="${VORTEX_RUST_BIN:-/usr/lib/vortex}/vortex-camera-rs"
if [[ -z "${VORTEX_CAMERA_PYTHON:-}" && -x "$rust_bin" ]]; then
  export VORTEX_CAMERA_DIR="$raiz"
  export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}" MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_:-131072}"
  exec "$rust_bin" "$@"
fi

export PYTHONPATH="$raiz${PYTHONPATH:+:$PYTHONPATH}"
# Vortex 4.0: que la memoria que la app suelta vuelva al sistema al momento (glibc guarda una
# arena por hilo y casi nunca las devuelve). Solo en las apps propias, nunca para toda la sesión.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}" MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_:-131072}"
exec python3 -m vortex_camera "$@"
