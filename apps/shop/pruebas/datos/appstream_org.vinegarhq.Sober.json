   "date_eol": null,
   "description": "<ul>\n            <li>Fix many long-standing performance issues and freezes</li>\n            <li>Fix a rendering bug affecting Nullscape and various other titles on certain GPUs</li>\n            <li>Fix some Vulkan related crashes</li>\n            <li>Update to Roblox 2.741.1061</li>\n          </ul>\n        ",
   "timestamp": "1790899200",
   "type": "stable",
   "urgency": null,
   "url": null,
   "version": "1.8.0"
  },
  {
   "date": null,
   "date_eol": null,
   "description": "<ul>\n            <li>Update to Roblox 2.725.1142</li>\n            <li>Asynchronously upload font glyphs to the GPU to get rid of lagspikes when first typing in textboxes</li>\n            <li>Make the in-app exit button work</li>\n            <li>Fix some Vulkan related crashes</li>\n            <li>Add a workaround for a bug in certain NVIDIA driver releases that may fix Vulkan startup crashes</li>\n          </ul>\n        ",
   "timestamp": "1781136000",
   "type": "stable",
   "urgency": null,
   "url": null,
   "version": "1.7.1"
  },
  {
   "date": null,
   "date_eol": null,
   "description": "<ul>\n            <li>Update to Roblox 2.723.787</li>\n            <li>Fix homescreen UI acting like a mobile interface</li>\n            <li>Fix videos not playing in certain experiences</li>\n            <li>Fix in-app trailers not playing</li>\n            <li>Fix captures feature not working</li>\n            <li>Fix in-app notifications and party features</li>\n            <li>Various other fixes and improvements to make Sober up to speed with native clients</li>\n          </ul>\n        ",
   "timestamp": "1780099200",
   "type": "stable",
   "urgency": null,
   "url": null,
   "version": "1.7.0"
  }
 ],
