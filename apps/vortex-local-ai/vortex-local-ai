#!/usr/bin/env bash
# Vortexine's Local AI: chat con modelos de IA que corren en tu PC (Ollama) y un vault de notas.
#   vortex-local-ai
# Corre «python -m vortex_local_ai» con el código donde esté:
#   1. VORTEX_LOCAL_AI_DIR, si la defines (para probar otra copia);
#   2. la carpeta de este mismo archivo, si es el repo;
#   3. /usr/share/vortex-local-ai, donde lo instala el paquete.
set -euo pipefail

aqui="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
raiz=""
for candidato in "${VORTEX_LOCAL_AI_DIR:-}" "$aqui" /usr/share/vortex-local-ai; do
  if [[ -n "$candidato" && -f "$candidato/vortex_local_ai/__init__.py" ]]; then
    raiz="$candidato"
    break
  fi
done
if [[ -z "$raiz" ]]; then
  echo "Vortexine's Local AI no está instalado del todo: no encuentro su código." >&2
  exit 1
fi

# 4.0: si está la versión en Rust (paquete vortex-rust), se usa esa: misma ventana (los QML de esta misma
# carpeta), menos memoria. VORTEX_LOCAL_AI_PYTHON=1 obliga a usar la de Python.
rust_bin="${VORTEX_RUST_BIN:-/usr/lib/vortex}/vortex-local-ai-rs"
if [[ -z "${VORTEX_LOCAL_AI_PYTHON:-}" && -x "$rust_bin" ]]; then
  export VORTEX_LOCAL_AI_DIR="$raiz"
  export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}" MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_:-131072}"
  exec "$rust_bin" "$@"
fi

export PYTHONPATH="$raiz${PYTHONPATH:+:$PYTHONPATH}"
# Vortex 4.0: que la memoria que la app suelta vuelva al sistema al momento (glibc guarda una
# arena por hilo y casi nunca las devuelve). Solo en las apps propias, nunca para toda la sesión.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}" MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_:-131072}"
exec python3 -m vortex_local_ai "$@"
