#!/usr/bin/env bash
# vortex-restore (1.10): Vortexine Restore, puntos de restauración de la configuración del escritorio.
# Si cambias Hyprland, el tema, la barra o los widgets y algo se rompe, vuelves a un punto anterior,
# todo o solo una parte, sin tocar lo demás. Idea del amigo de Mike (THYRVAREN).
#
#   vortex restore crear [NOTA]             un punto ahora (con tu nota)
#   vortex restore auto [MOTIVO]            un punto solo si algo cambió (temporizador, inicio, actualizar)
#   vortex restore lista [--json]           los puntos, del más nuevo al más viejo
#   vortex restore ver PUNTO                qué partes y archivos cambiaron en ese punto
#   vortex restore diferencias PUNTO [PARTE]  qué cambia de ahora a ese punto (para revisar antes)
#   vortex restore volver PUNTO [PARTE...]  vuelve a ese punto (todo, o solo esas partes)
#   vortex restore partes                   las partes y sus archivos
#   vortex emergencia                       desde la terminal (Ctrl+Alt+F3) si el escritorio no sirve
#
# Los puntos son commits de un repo git aparte (~/.local/share/vortex/restore) cuyo árbol de trabajo es
# tu HOME, pero que solo sigue los archivos de PARTES: unos KB de texto. No queda nada corriendo: los
# puntos automáticos los hace un temporizador de systemd cada 30 min (y solo si algo cambió), el inicio
# de sesión, «vortex actualizar» y cada «volver» (así un «volver» también se puede deshacer).
# Las claves (OneDrive, IA de Miku) y los respaldos viejos no entran.
set -uo pipefail

REPO="${VORTEX_RESTORE_REPO:-${XDG_DATA_HOME:-$HOME/.local/share}/vortex/restore}"
VORTEX="${VORTEX_BIN:-vortex}"

# parte|nombre para mostrar|rutas (desde tu HOME, separadas por espacios)
PARTES=(
  "hyprland|Hyprland (ventanas, atajos, monitores)|.config/hypr .config/vortex/hypr-mio.lua .config/vortex/teclado.lua"
  "tema|Barra, tema y dock|.config/serpantinum"
  "widgets|Widgets del escritorio|.local/state/serpantinum/widgets"
  "terminal|Terminal|.config/kitty"
  "apariencia|Apariencia de las apps (GTK y Qt)|.config/gtk-3.0/settings.ini .config/gtk-3.0/gtk.css .config/gtk-4.0/settings.ini .config/gtk-4.0/gtk.css .config/qt5ct .config/qt6ct"
  "vortex|Ajustes de Vortexine's (avisos, Miku)|.config/vortex/actualizaciones.conf .config/vortex/miku.json .config/vortex/ventanas"
)

aviso() { printf 'vortex restore: %s\n' "$*" >&2; }

G() {
  git --git-dir="$REPO" --work-tree="$HOME" -c core.quotepath=off -c commit.gpgsign=false \
    -c user.name="Vortexine Restore" -c user.email="restore@vortexine.local" "$@"
}

parte_campo() { # PARTE CAMPO(2|3)
  local p
  for p in "${PARTES[@]}"; do [[ "${p%%|*}" == "$1" ]] && { cut -d'|' -f"$2" <<<"$p"; return 0; }; done
  return 1
}
partes_ids() { local p; for p in "${PARTES[@]}"; do printf '%s\n' "${p%%|*}"; done; }

# La parte a la que pertenece un archivo (ruta desde HOME).
parte_de() {
  local p r
  for p in "${PARTES[@]}"; do
    for r in $(cut -d'|' -f3 <<<"$p"); do
      [[ "$1" == "$r" || "$1" == "$r/"* ]] && { printf '%s\n' "${p%%|*}"; return 0; }
    done
  done
}

iniciar() {
  [[ -d "$REPO" ]] && return 0
  mkdir -p "$REPO" && git init -q --bare "$REPO" || { aviso "no pude crear $REPO"; exit 1; }
  G config core.bare false
  G config status.showUntrackedFiles no
  # Lo que no es configuración: respaldos, cachés, archivos grandes de imagen.
  printf '%s\n' 'respaldo-*' '*.antes-*' '*.bak' '*.log' '*.png' '*.jpg' '*.mp4' 'onedrive/' >"$REPO/info/exclude"
}

# Las rutas de las partes que existen o que ya estaban guardadas (para que un borrado también quede).
rutas() { # [PARTE...]
  local id r ids=("$@")
  ((${#ids[@]})) || mapfile -t ids < <(partes_ids)
  for id in "${ids[@]}"; do
    for r in $(parte_campo "$id" 3); do
      if [[ -e "$HOME/$r" ]] || [[ -n "$(G ls-files -- "$r" 2>/dev/null | head -n1)" ]]; then printf '%s\n' "$r"; fi
    done
  done
}

preparar() { # [PARTE...]: pasa al índice el estado de ahora
  local r lista=()
  mapfile -t lista < <(rutas "$@")
  ((${#lista[@]})) || return 0
  for r in "${lista[@]}"; do G add -A -- "$r" >/dev/null 2>&1 || true; done
}

hay_puntos() { G rev-parse -q --verify HEAD >/dev/null 2>&1; }

guardar() { # TIPO NOTA [--siempre]
  iniciar
  preparar
  if hay_puntos && G diff --cached --quiet 2>/dev/null; then
    [[ "${3:-}" == --siempre ]] || return 1
  fi
  G commit -q --allow-empty -m "$2" -m "Vortex-Tipo: $1" >/dev/null || { aviso "no pude guardar el punto"; exit 1; }
  G rev-parse --short HEAD
}

# Un PUNTO: el id corto (o largo) de la lista, o un número: 1 = el más nuevo.
punto() {
  local id="${1:-}"
  [[ -n "$id" ]] || { aviso "falta el punto (mira «vortex restore lista»)"; exit 1; }
  hay_puntos || { aviso "todavía no hay puntos"; exit 1; }
  if [[ "$id" =~ ^[0-9]{1,3}$ ]]; then
    id="$(G rev-list --skip=$((id - 1)) --max-count=1 HEAD 2>/dev/null)"
  fi
  G rev-parse -q --verify "${id}^{commit}" 2>/dev/null || { aviso "no existe el punto «$1»"; exit 1; }
}

partes_cambiadas() { # COMMIT → ids de las partes que cambiaron en él, separadas por espacios
  local f
  G diff-tree --root --no-commit-id --name-only -r "$1" 2>/dev/null | while IFS= read -r f; do parte_de "$f"; done |
    sort -u | tr '\n' ' ' | sed 's/ $//'
}

cmd_lista() {
  iniciar
  if [[ "${1:-}" == --json ]]; then
    hay_puntos || { echo '[]'; return 0; }
    local c fecha tipo nota partes
    while IFS=$'\t' read -r c fecha tipo nota; do
      partes="$(partes_cambiadas "$c")"
      jq -cn --arg id "${c:0:9}" --argjson fecha "$fecha" --arg tipo "${tipo:-manual}" --arg nota "$nota" \
        --arg partes "$partes" '{id: $id, fecha: $fecha, tipo: $tipo, nota: $nota,
          partes: ($partes | split(" ") | map(select(. != "")))}'
    done < <(G log --max-count=200 --format='%H%x09%ct%x09%(trailers:key=Vortex-Tipo,valueonly,separator=)%x09%s' 2>/dev/null) |
      jq -cs .
    return 0
  fi
  hay_puntos || { echo "Todavía no hay puntos. Crea uno con: vortex restore crear \"mi nota\""; return 0; }
  local n=0 c fecha tipo nota
  while IFS=$'\t' read -r c fecha tipo nota; do
    n=$((n + 1))
    printf '%3d  %s  %s  %-9s %s' "$n" "${c:0:9}" "$(date -d "@$fecha" '+%d/%m %H:%M')" "${tipo:-manual}" "$nota"
    local p
    p="$(partes_cambiadas "$c")"
    [[ -n "$p" ]] && printf '  [%s]' "$p"
    printf '\n'
  done < <(G log --max-count="${LIMITE:-30}" --format='%H%x09%ct%x09%(trailers:key=Vortex-Tipo,valueonly,separator=)%x09%s')
}

cmd_ver() {
  local c f
  c="$(punto "${1:-}")" || exit 1
  G log -1 --format='%h  %cd  %s' --date=format:'%d/%m/%Y %H:%M' "$c"
  G diff-tree --root --no-commit-id --name-status -r "$c" | while IFS=$'\t' read -r estado f; do
    printf '  %-10s %s %s\n' "$(parte_de "$f")" "$estado" "$f"
  done
}

cmd_diferencias() {
  local c
  c="$(punto "${1:-}")" || exit 1
  shift
  preparar "$@"
  local lista=()
  mapfile -t lista < <(rutas "$@")
  ((${#lista[@]})) || return 0
  # De ahora (índice) a ese punto: «-» lo que tienes ahora, «+» lo que volvería.
  G diff --cached -R "$c" -- "${lista[@]}"
}

aplicar() { # PARTE...: que se note sin cerrar sesión
  local id hypr=0 shell=0 term=0
  for id in "$@"; do
    case "$id" in hyprland) hypr=1 ;; tema | widgets) shell=1 ;; terminal) term=1 ;; esac
  done
  if ((hypr)) && command -v hyprctl >/dev/null; then
    { [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && hyprctl reload || hyprctl -i 0 reload; } >/dev/null 2>&1 || true
  fi
  ((shell)) && "$VORTEX" reiniciar-shell >/dev/null 2>&1 || true
  ((term)) && pkill -USR1 -x kitty 2>/dev/null || true
}

cmd_volver() {
  local c nota ids=() id r f
  c="$(punto "${1:-}")" || exit 1
  shift
  for id in "$@"; do
    [[ "$id" == todo ]] && { ids=(); break; }
    parte_campo "$id" 2 >/dev/null || { aviso "no conozco la parte «$id» (mira «vortex restore partes»)"; exit 1; }
    ids+=("$id")
  done
  ((${#ids[@]})) || mapfile -t ids < <(partes_ids)
  nota="$(G log -1 --format=%s "$c")"
  # Lo de ahora queda como punto: «volver» también se puede deshacer.
  guardar antes "Antes de volver a «$nota»" --siempre >/dev/null || true
  for id in "${ids[@]}"; do
    for r in $(parte_campo "$id" 3); do
      if G cat-file -e "$c:$r" 2>/dev/null; then
        # Los archivos que se agregaron después de ese punto se quitan (--no-overlay); lo demás vuelve.
        G checkout -q --no-overlay "$c" -- "$r" || aviso "no pude volver $r"
      else
        # En ese punto no existía: se quitan los archivos guardados de esa ruta (solo esos).
        while IFS= read -r f; do rm -f -- "$HOME/$f"; G rm -q --cached -- "$f" >/dev/null 2>&1; done < <(G ls-files -- "$r")
      fi
    done
  done
  guardar volver "Volviste a «$nota» ($(G log -1 --format=%cd --date=format:'%d/%m %H:%M' "$c")): ${ids[*]}" >/dev/null || true
  aplicar "${ids[@]}"
  printf 'Listo: %s volvió a «%s».\n' "${ids[*]}" "$nota"
}

cmd_partes() {
  local p
  for p in "${PARTES[@]}"; do
    IFS='|' read -r id nombre rs <<<"$p"
    printf '%-11s %s\n            %s\n' "$id" "$nombre" "$rs"
  done
}

# Desde una terminal de texto (Ctrl+Alt+F3, entras con tu usuario): elige un punto y vuelve todo.
cmd_emergencia() {
  iniciar
  hay_puntos || { echo "No hay puntos de restauración guardados todavía."; exit 1; }
  echo "Vortexine Restore: modo de emergencia"
  echo "Vuelve toda la configuración del escritorio a un punto anterior. Tus archivos no se tocan."
  echo
  local sugerido
  sugerido="$(G log --max-count=30 --format='%(trailers:key=Vortex-Tipo,valueonly,separator=)' | grep -n '^inicio$' | sed -n 2p | cut -d: -f1)"
  [[ -n "$sugerido" ]] || sugerido=2
  LIMITE=15 cmd_lista
  echo
  echo "Sugerido: $sugerido (el inicio de sesión anterior al último: la última vez que el escritorio arrancó"
  echo "antes de los cambios de ahora)."
  local n
  read -r -p "¿A qué número vuelvo? [Enter = $sugerido, q = salir]: " n
  [[ "$n" == q ]] && exit 0
  n="${n:-$sugerido}"
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "Eso no es un número."; exit 1; }
  cmd_volver "$n"
  echo
  echo "Vuelve a tu escritorio con Ctrl+Alt+F1 o Ctrl+Alt+F2. Si sigue mal, cierra sesión y entra de nuevo;"
  echo "y si hace falta, aquí mismo puedes volver a otro punto con: vortex emergencia"
}

case "${1:-lista}" in
  crear) shift; c="$(guardar manual "${*:-Punto manual}" --siempre)" && echo "Punto $c guardado." ;;
  auto) shift; tipo=auto; [[ "${1:-}" == inicio || "${1:-}" == actualizar ]] && { tipo="$1"; shift; }
    nota="${*:-}"
    [[ -n "$nota" ]] || case "$tipo" in inicio) nota="Inicio de sesión" ;; actualizar) nota="Antes de actualizar" ;; *) nota="Cambios guardados solos" ;; esac
    if [[ "$tipo" == inicio ]]; then guardar "$tipo" "$nota" --siempre >/dev/null; else guardar "$tipo" "$nota" >/dev/null; fi
    exit 0 ;;
  lista) shift; cmd_lista "$@" ;;
  ver) shift; cmd_ver "$@" ;;
  diferencias) shift; cmd_diferencias "$@" ;;
  volver) shift; cmd_volver "$@" ;;
  partes) cmd_partes ;;
  emergencia) cmd_emergencia ;;
  *) sed -n '5,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
