#!/usr/bin/env bash
# vortex: comando para manejar Vortex OS.
set -euo pipefail

VORTEX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vortex"
ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/vortex"
CAELESTIA="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia"

ayuda() {
  cat <<'EOF'
Uso: vortex <comando>

  perfil [ligero|equilibrado|bonito]   muestra o cambia el perfil gráfico
  modo-juego on|off|alternar           apaga los efectos del escritorio mientras juegas
  claude                               abre Claude en una terminal
  claude pausa|reanudar|estado         corta o devuelve a Claude el acceso a tu pantalla
  bench [--guardar] [--comparar A B]   mide RAM, servicios, paquetes y arranque
  actualizar                           actualiza Vortex, el sistema y Caelestia
  version
EOF
}

aviso() { printf 'vortex: %s\n' "$*" >&2; }

notificar() { command -v notify-send >/dev/null && notify-send -a "Vortex OS" "$@" || true; }

hypr() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl "$@"
  else
    hyprctl -i 0 "$@"
  fi
}

hypr_corriendo() { command -v hyprctl >/dev/null && hypr version >/dev/null 2>&1; }

# Compara shell.json con el último generado por Vortex y pasa a shell-mio.json los
# valores que el usuario cambió desde los ajustes de Caelestia. Las listas se tratan
# como un solo valor. Caelestia guarda las listas con cada elemento expandido (enabled,
# inhibitWhenAudio... con sus valores por defecto), así que antes de comparar se
# normalizan los dos lados para no tomar esa expansión por un cambio del usuario.
rescatar_cambios_shell() {
  local actual="$CAELESTIA/shell.json" generado="$ESTADO/shell-generado.json"
  [[ -f "$actual" && -f "$generado" ]] || return 0
  cmp -s "$actual" "$generado" && return 0
  local cambios
  cambios="$(jq -n --slurpfile a "$generado" --slurpfile b "$actual" '
    def norm: if type == "array" then map(
        if type == "object" then with_entries(select(.value != null and
          ({enabled: true, inhibitWhenAudio: false, inhibitWhenCharging: false, respectInhibitors: true}[.key] != .value)))
        else . end)
      else . end;
    def hojas(p): if type == "object" and length > 0
      then to_entries[] | .key as $k | .value | hojas(p + [$k])
      else {p: p, v: .} end;
    reduce ($b[0] | hojas([])) as $h ({};
      if ((try ($a[0] | getpath($h.p)) catch null) | norm) != ($h.v | norm) then setpath($h.p; $h.v) else . end)
  ' 2>/dev/null)" || { aviso "no pude leer los cambios de shell.json; se regenera sin ellos"; return 0; }
  [[ -n "$cambios" && "$cambios" != '{}' ]] || return 0
  if jq -s '.[0] * .[1]' "$CONF/shell-mio.json" <(echo "$cambios") >"$CONF/shell-mio.json.tmp"; then
    mv "$CONF/shell-mio.json.tmp" "$CONF/shell-mio.json"
    aviso "tus cambios en los ajustes de Caelestia se guardaron en $CONF/shell-mio.json"
  else
    rm -f "$CONF/shell-mio.json.tmp"
    aviso "no pude guardar tus cambios de los ajustes de Caelestia en $CONF/shell-mio.json"
  fi
}

cmd_perfil() {
  local nombre="${1:-}" recargar=1
  [[ "${2:-}" == --sin-recargar ]] && recargar=0

  if [[ -z "$nombre" ]]; then
    cat "$CONF/perfil" 2>/dev/null || echo "(sin perfil)"
    return
  fi
  local lua="$VORTEX_DIR/config/perfiles/$nombre.lua"
  local json="$VORTEX_DIR/config/perfiles/$nombre.json"
  [[ -f "$lua" && -f "$json" ]] || { aviso "no existe el perfil «$nombre» (ligero, equilibrado, bonito)"; exit 1; }

  mkdir -p "$CONF" "$CAELESTIA"
  install -m644 "$lua" "$CONF/perfil.lua"
  # Tus ajustes del shell van en shell-mio.json y siempre ganan sobre el perfil.
  [[ -f "$CONF/shell-mio.json" ]] || echo '{}' >"$CONF/shell-mio.json"
  jq empty "$CONF/shell-mio.json" 2>/dev/null \
    || { aviso "$CONF/shell-mio.json no es JSON válido: corrígelo y vuelve a intentar"; exit 1; }
  # Los cambios hechos desde los ajustes de Caelestia (Nexus) se guardan en
  # shell.json: antes de regenerarlo se pasan a shell-mio.json para no perderlos.
  rescatar_cambios_shell
  # En equipos sin batería (PC de escritorio, VM) Caelestia no debe suspender a los
  # 10 minutos: se deja solo bloquear y apagar pantalla. El perfil y shell-mio.json
  # pueden pisarlo.
  local idle='{}'
  if ! compgen -G '/sys/class/power_supply/BAT*' >/dev/null; then
    idle='{"general":{"idle":{"timeouts":[
      {"timeout":180,"idleAction":"lock"},
      {"timeout":300,"idleAction":"dpms off","returnAction":"dpms on"}]}}}'
  fi
  mkdir -p "$ESTADO"
  jq -s '.[0] * .[1] * .[2]' <(echo "$idle") "$json" "$CONF/shell-mio.json" >"$CAELESTIA/shell.json.tmp"
  mv "$CAELESTIA/shell.json.tmp" "$CAELESTIA/shell.json"
  cp "$CAELESTIA/shell.json" "$ESTADO/shell-generado.json"
  echo "$nombre" >"$CONF/perfil"

  if ((recargar)) && hypr_corriendo; then
    hypr reload >/dev/null
  fi
  echo "Perfil: $nombre"
}

cmd_modo_juego() {
  local marca="$ESTADO/modo-juego"
  mkdir -p "$ESTADO"
  case "${1:-alternar}" in
    on)
      hypr_corriendo && hypr eval 'hl.config({ animations = { enabled = false }, decoration = { blur = { enabled = false }, shadow = { enabled = false } } })' >/dev/null
      if command -v powerprofilesctl >/dev/null; then
        # Solo guarda el perfil si no hay uno guardado: un segundo «on» (Super+G y
        # luego gamemode, o dos juegos) no debe pisarlo con «performance».
        # Si no se puede leer el perfil actual no se escribe nada (un archivo vacío
        # haría que «off» intentara restaurar un perfil inexistente).
        if [[ ! -s "$marca.anterior" ]]; then
          local previo
          previo="$(powerprofilesctl get 2>/dev/null)" || previo=""
          [[ -n "$previo" ]] && printf '%s\n' "$previo" >"$marca.anterior"
        fi
        powerprofilesctl set performance 2>/dev/null || true
      fi
      touch "$marca"
      notificar -t 2000 "Modo juego activado" "Efectos apagados mientras juegas"
      ;;
    off)
      # Recargar devuelve todo a lo que diga el perfil.
      hypr_corriendo && hypr reload >/dev/null
      if command -v powerprofilesctl >/dev/null && [[ -s "$marca.anterior" ]]; then
        local anterior
        anterior="$(cat "$marca.anterior")"
        [[ -n "$anterior" ]] && { powerprofilesctl set "$anterior" 2>/dev/null || true; }
      fi
      rm -f "$marca" "$marca.anterior"
      notificar -t 2000 "Modo juego desactivado"
      ;;
    alternar)
      if [[ -f "$marca" ]]; then cmd_modo_juego off; else cmd_modo_juego on; fi
      ;;
    *) aviso "usa: vortex modo-juego on|off|alternar"; exit 1 ;;
  esac
}

cmd_claude() {
  local pausa="$CONF/claude-pausa"
  case "${1:-}" in
    pausa)
      mkdir -p "$CONF"; touch "$pausa"
      echo "Claude ya no puede ver tu pantalla, ventanas ni portapapeles."
      ;;
    reanudar)
      rm -f "$pausa"
      echo "Claude puede volver a ver tu pantalla cuando se lo pidas."
      ;;
    estado)
      if [[ -f "$pausa" ]]; then echo "en pausa"; else echo "con acceso (te avisa cada vez que mira)"; fi
      ;;
    "")
      # El instalador de Claude Code lo deja en ~/.local/bin, que no está en el PATH
      # del escritorio ni de fish: se agrega aquí para que lo vea fish y el fish final.
      export PATH="$HOME/.local/bin:$PATH"
      local term="${TERMINAL:-foot}" orden=(fish -c 'cd ~; claude; exec fish')
      if [[ "$term" == foot ]]; then
        exec foot --title "Claude · Vortex" "${orden[@]}"
      fi
      exec "$term" -e "${orden[@]}"
      ;;
    *) aviso "usa: vortex claude [pausa|reanudar|estado]"; exit 1 ;;
  esac
}

cmd_actualizar() {
  if [[ -d "$VORTEX_DIR/.git" ]]; then
    # Sin red, sin repo publicado o con historia divergida el pull falla: no debe
    # abortar antes de actualizar los paquetes, ni quedarse pidiendo credenciales.
    GIT_TERMINAL_PROMPT=0 git -C "$VORTEX_DIR" pull --ff-only \
      || aviso "no pude actualizar Vortex (¿sin red o repo sin publicar?); sigo con los paquetes"
  else
    aviso "este Vortex no es un repo git; no puedo actualizarlo"
  fi
  paru -Syu
  command -v caelestia >/dev/null && caelestia update --aur-helper paru
  cmd_perfil "$(cat "$CONF/perfil" 2>/dev/null || echo equilibrado)"
}

case "${1:-ayuda}" in
  perfil) shift; cmd_perfil "$@" ;;
  modo-juego) shift; cmd_modo_juego "$@" ;;
  claude) shift; cmd_claude "$@" ;;
  bench) shift; exec "$VORTEX_DIR/bin/vortex-bench" "$@" ;;
  actualizar) cmd_actualizar ;;
  version) cat "$CONF/version" 2>/dev/null || echo "sin instalar (código en $VORTEX_DIR)" ;;
  ayuda | -h | --help) ayuda ;;
  *) aviso "comando desconocido: $1"; ayuda; exit 1 ;;
esac
