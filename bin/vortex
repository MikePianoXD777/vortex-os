#!/usr/bin/env bash
# vortex: comando para manejar Vortexine's OS.
set -euo pipefail

VORTEX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Copiado en /usr/local/bin, «..» no es el repo: el instalador deja su ruta en /etc/vortex-release.
VORTEX_RELEASE="${VORTEX_RELEASE:-/etc/vortex-release}"
if [[ ! -f "$VORTEX_DIR/install.sh" && -r "$VORTEX_RELEASE" ]]; then
  repo="$(sed -n 's/^VORTEX_REPO="\(.*\)"$/\1/p' "$VORTEX_RELEASE")"
  [[ -f "$repo/install.sh" ]] && VORTEX_DIR="$repo"
  unset repo
fi
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vortex"
ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/vortex"
SHELL_QML=/usr/share/serpantinum/src/quickshell/Shell.qml

ayuda() {
  cat <<'EOF'
Uso: vortex <comando>

  modo-juego on|off|alternar           apaga los efectos del escritorio mientras juegas
  configurar-usuario                   deja tu usuario con la config de Vortex (sin instalar nada)
  gestor [estado|encender|apagar]      reparte solo la CPU y la RAM (prioridad a la ventana
                                       enfocada, modo juego automático, presión de memoria)
  claude                               abre Claude en una terminal (si está activado)
  claude activar|desactivar|activado   conecta Vortexine's OS con Claude (viene apagado; también
                                       desde Ajustes → General → Claude). Necesita tu cuenta de Claude
  claude pausa|reanudar|estado         corta o devuelve a Claude el acceso a tu pantalla
  claude instalar                      instala Claude Code para tu usuario (la ISO lo hace sola
                                       en tu primer inicio con red si elegiste Claude al instalar)
  bench [--guardar] [--comparar A B]   mide RAM, servicios, paquetes y arranque
  actualizar                           actualiza Vortex, su shell y el sistema
  fondo [ARCHIVO]                      pone un fondo (y los colores del sistema salen de él)
  otaku on|off|alternar|estado|otro    modo otaku: fondo de Miku Nakano y un toque de personalización
  java [aplicar]                       muestra o aplica a Minecraft los ajustes de Java para jugar
  version
EOF
}

aviso() { printf 'vortex: %s\n' "$*" >&2; }

notificar() { command -v notify-send >/dev/null && notify-send -a "Vortexine's OS" "$@" || true; }

hypr() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl "$@"
  else
    hyprctl -i 0 "$@"
  fi
}

hypr_corriendo() { command -v hyprctl >/dev/null && hypr version >/dev/null 2>&1; }

# Llama a la IPC del shell (Serpantinum). Falla si el shell no está corriendo.
shell_ipc() { quickshell ipc -p "$SHELL_QML" call "$@"; }

# Monitores conectados (nombres de Hyprland).
monitores() { hypr -j monitors 2>/dev/null | jq -r '.[].name'; }

# Carpeta de fondos: la de los ajustes del shell o la de Vortex.
carpeta_fondos() {
  local dir
  dir="$(jq -r '.wallpaperDir // empty' "${XDG_CONFIG_HOME:-$HOME/.config}/serpantinum/settings.json" 2>/dev/null)"
  printf '%s\n' "${dir:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Fondos}"
}

cmd_fondo() {
  local archivo="${1:-}"
  if [[ -z "$archivo" ]]; then
    # El de Vortex primero; si no está, el primero de la carpeta.
    archivo="$(carpeta_fondos)/vortex-azul.jpg"
    [[ -f "$archivo" ]] || archivo="$(find "$(carpeta_fondos)" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | sort | head -n1)"
    [[ -n "$archivo" ]] || { aviso "no hay fondos en $(carpeta_fondos)"; exit 1; }
  fi
  [[ -f "$archivo" ]] || { aviso "no existe: $archivo"; exit 1; }
  archivo="$(readlink -f "$archivo")"
  local m
  for m in $(monitores); do
    shell_ipc wallpaper setWallpaper "$m" "$archivo" fade >/dev/null
  done
}

# Al iniciar sesión: si todavía no hay fondo, pone el primero de la carpeta de Vortex
# (así el primer arranque ya tiene fondo y colores). Espera a que el shell responda.
cmd_primer_inicio() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/serpantinum/wallpaper"
  compgen -G "$cache/current_*" >/dev/null && return 0
  local i
  for i in $(seq 1 30); do
    shell_ipc wallpaper getWallpaper "$(monitores | head -n1)" >/dev/null 2>&1 && break
    sleep 1
  done
  cmd_fondo
}

cmd_modo_juego() {
  local marca="$ESTADO/modo-juego"
  mkdir -p "$ESTADO"
  case "${1:-alternar}" in
    on)
      hypr_corriendo && hypr eval 'hl.config({ animations = { enabled = false }, decoration = { blur = { enabled = false }, shadow = { enabled = false } } })' >/dev/null
      if command -v powerprofilesctl >/dev/null; then
        # Solo guarda el perfil si no hay uno guardado: un segundo «on» (Super+G y
        # luego gamemode, o dos juegos) no debe pisarlo con «performance».
        # Si no se puede leer el perfil actual no se escribe nada (un archivo vacío
        # haría que «off» intentara restaurar un perfil inexistente).
        if [[ ! -s "$marca.anterior" ]]; then
          local previo
          previo="$(powerprofilesctl get 2>/dev/null)" || previo=""
          [[ -n "$previo" ]] && printf '%s\n' "$previo" >"$marca.anterior"
        fi
        powerprofilesctl set performance 2>/dev/null || true
      fi
      # Vortex: pausa el fondo animado (video) en todos los monitores mientras juegas:
      # así no decodifica video detrás del juego. Con un fondo fijo no hace nada.
      # La marca .fondo dice que lo pausó Vortex: solo entonces «off» lo reanuda.
      if shell_ipc wallpaper setPlayback all pause >/dev/null 2>&1; then
        touch "$marca.fondo"
      fi
      touch "$marca"
      notificar -t 2000 "Modo juego activado" "Efectos apagados mientras juegas"
      ;;
    off)
      # Recargar devuelve todo a como estaba en la config.
      hypr_corriendo && hypr reload >/dev/null
      if command -v powerprofilesctl >/dev/null && [[ -s "$marca.anterior" ]]; then
        local anterior
        anterior="$(cat "$marca.anterior")"
        [[ -n "$anterior" ]] && { powerprofilesctl set "$anterior" 2>/dev/null || true; }
      fi
      # Vortex: el fondo animado vuelve a correr (solo si lo pausó «on»).
      if [[ -f "$marca.fondo" ]]; then
        shell_ipc wallpaper setPlayback all play >/dev/null 2>&1 || true
      fi
      rm -f "$marca" "$marca.anterior" "$marca.fondo"
      notificar -t 2000 "Modo juego desactivado"
      ;;
    alternar)
      if [[ -f "$marca" ]]; then cmd_modo_juego off; else cmd_modo_juego on; fi
      ;;
    *) aviso "usa: vortex modo-juego on|off|alternar"; exit 1 ;;
  esac
}

# Gestor de recursos automático (bin/vortex-gestor, servicio de usuario vortex-gestor).
cmd_gestor() {
  local unidad=vortex-gestor.service
  case "${1:-estado}" in
    estado) gestor_estado ;;
    encender)
      systemctl --user enable "$unidad" >/dev/null 2>&1 || { aviso "no pude habilitar $unidad"; exit 1; }
      # Fuera de Hyprland (p. ej. por SSH) no puede arrancar: lo hará al entrar al escritorio.
      if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || hypr_corriendo; then
        systemctl --user start "$unidad" || true
      fi
      echo "Gestor de recursos encendido (arranca solo con cada sesión)."
      ;;
    apagar)
      systemctl --user disable --now "$unidad" >/dev/null 2>&1 || true
      echo "Gestor de recursos apagado (no vuelve a arrancar hasta: vortex gestor encender)."
      ;;
    *) aviso "usa: vortex gestor [estado|encender|apagar]"; exit 1 ;;
  esac
}

gestor_estado() {
  local unidad=vortex-gestor.service archivo="${XDG_RUNTIME_DIR:-/run/user/$UID}/vortex/gestor"
  local activo habilitado k v
  activo="$(systemctl --user is-active "$unidad" 2>/dev/null)" || true
  habilitado="$(systemctl --user is-enabled "$unidad" 2>/dev/null)" || true
  if [[ "$activo" != active || ! -r "$archivo" ]]; then
    echo "Gestor de recursos: no está corriendo (${activo:-desconocido})"
    if [[ "$habilitado" == enabled ]]; then
      echo "  Está habilitado: arranca solo al entrar al escritorio (Hyprland)."
    else
      echo "  Está apagado. Para encenderlo: vortex gestor encender"
    fi
    return 0
  fi
  local -A e=()
  while IFS='=' read -r k v; do [[ -n "$k" ]] && e[$k]="$v"; done <"$archivo"
  local mem
  mem="$(systemctl --user show -p MemoryCurrent --value "$unidad" 2>/dev/null)" || mem=""
  printf 'Gestor de recursos: activo desde las %(%H:%M)T' "${e[inicio]:-0}"
  [[ "$mem" =~ ^[0-9]+$ ]] && printf ' (usa %s MB)' "$(((mem + 524288) / 1048576))"
  printf '
'
  if [[ "${e[foco_pid]:-0}" != 0 ]]; then
    printf '  Ventana enfocada: %s (pid %s)' "${e[foco_clase]:-?}" "${e[foco_pid]}"
    if [[ -n "${e[foco_cgroup]:-}" ]]; then printf ', con prioridad en %s' "${e[foco_cgroup]##*/}"; else printf ', sin cambiar (no se puede ordenar)'; fi
    [[ "${e[foco_nice]:-0}" != 0 ]] && printf ' y nice %s' "${e[foco_nice]}"
    printf '
'
  else
    echo "  Ventana enfocada: ninguna"
  fi
  echo "  Apps con su propio scope: ${e[apps]:-0}"
  local modo
  case "${e[modo_juego]:-apagado}" in
    propio) modo="encendido por el gestor" ;;
    ajeno) modo="encendido (a mano o por gamemode)" ;;
    *) modo="apagado" ;;
  esac
  printf '  Juegos abiertos: %s · modo juego: %s · fondo animado: %s\n' "${e[juegos]:-0}" "$modo" \
    "$([[ "${e[fondo_pausado]:-0}" == 1 ]] && echo en pausa || echo normal)"
  printf '  Presión de memoria: %s · avisos: %s' "${e[psi]:-?}" "${e[psi_eventos]:-0}"
  [[ "${e[psi_ultimo]:-0}" != 0 ]] && printf ' (el último a las %(%H:%M)T; memoria soltada: %s)' "${e[psi_ultimo]}" "${e[reclamos]:-0}"
  printf '\n'
  [[ -r /proc/pressure/memory ]] && printf '    ahora: %s\n' "$(sed 's/ total=.*//' /proc/pressure/memory | paste -sd ',' | sed 's/,/, /')"
  echo "  El shell suelta memoria cuando falta: ${e[shell_soltar]:-sin probar}"
}

# Instala Claude Code para tu usuario, sin sudo: install/claude.sh, lo mismo que hace install.sh.
#   vortex claude instalar              ahora, aquí
#   vortex claude instalar --al-entrar  en segundo plano al iniciar sesión (lo lanza vortex-sesion
#                                       si el instalador dejó la marca /etc/vortex/claude): espera a
#                                       que el escritorio arranque y a que haya red. Sin red no hace
#                                       nada y no deja su marca: se reintenta en el próximo inicio.
# Deja ~/.local/state/vortex/claude-listo cuando termina; con esa marca vortex-sesion ya no lo
# vuelve a intentar. Solo corre una instalación a la vez (candado claude.lock).
cmd_claude_instalar() {
  local al_entrar=0 hay_red=0 i
  case "${1:-}" in
    --al-entrar) al_entrar=1 ;;
    "") ;;
    *) aviso "usa: vortex claude instalar"; exit 1 ;;
  esac
  [[ -f "$VORTEX_DIR/install/claude.sh" ]] || { aviso "no encuentro el código de Vortex ($VORTEX_DIR)"; exit 1; }
  mkdir -p "$ESTADO"
  exec 9>"$ESTADO/claude.lock"
  if ((al_entrar)); then
    flock -n 9 || exit 0
  else
    flock -n 9 || {
      echo "Ya hay otra instalación de Claude en curso (la del inicio de sesión): espero a que termine…"
      flock 9
    }
  fi
  export VORTEX_DIR VORTEX_DRY_RUN="${VORTEX_DRY_RUN:-0}"
  # shellcheck source=install/lib.sh
  source "$VORTEX_DIR/install/lib.sh"
  # shellcheck source=install/claude.sh
  source "$VORTEX_DIR/install/claude.sh"
  if ((al_entrar)); then
    # Que el escritorio termine de arrancar antes de gastar CPU y red en esto.
    sleep "${VORTEX_CLAUDE_ESPERA:-30}"
    for i in $(seq "${VORTEX_CLAUDE_INTENTOS_RED:-18}"); do
      if claude_hay_red; then hay_red=1; break; fi
      sleep "${VORTEX_CLAUDE_PAUSA_RED:-10}"
    done
    if ((!hay_red)); then
      echo "vortex: sin red; Claude se instalará en el próximo inicio de sesión con internet"
      exit 0
    fi
  fi
  claude_instalar_usuario || exit 1
  [[ "$VORTEX_DRY_RUN" == 1 ]] && exit 0
  : >"$ESTADO/claude-listo"
  if ((al_entrar)); then
    # Lo lanza vortex-sesion antes de que arranque el escritorio, y el bus de la sesión no lo
    # exporta PAM sino el escritorio: sin DBUS_SESSION_BUS_ADDRESS, notify-send no lo encontraría
    # aunque el servidor de notificaciones ya esté en pie. El de systemd está en $XDG_RUNTIME_DIR/bus.
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/bus" ]]; then
      export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
    fi
    notificar -t 10000 "Claude está listo" "Presiona Super+A. Toca Espacio para hablarle con el micrófono."
  else
    echo "Claude está listo: Super+A (o «vortex claude») lo abre."
  fi
}

# Claude viene apagado: se activa al instalar (casilla «Claude») o después desde Ajustes. Está
# activado si se instaló (marca claude-listo o el ejecutable) y no se desactivó (claude-apagado).
claude_activado() {
  [[ -e "$CONF/claude-apagado" ]] && return 1
  # /etc/vortex/claude: se eligió Claude al instalar (la ISO lo instala sola al entrar).
  [[ -e "${VORTEX_MARCA_CLAUDE:-/etc/vortex/claude}" || -e "$ESTADO/claude-listo" || -x "$HOME/.local/bin/claude" ]] ||
    command -v claude >/dev/null 2>&1
}

cmd_claude() {
  local pausa="$CONF/claude-pausa"
  case "${1:-}" in
    activar)
      rm -f "$CONF/claude-apagado"
      notificar "Activando Claude" "Se está instalando para tu usuario (necesita internet)…"
      if (cmd_claude_instalar); then
        notificar -t 15000 "Claude activado" "Super+A lo abre. La primera vez te pide iniciar sesión con tu cuenta de Claude."
      else
        notificar -u critical "No pude activar Claude" "Revisa tu conexión a internet y vuelve a intentarlo desde Ajustes."
        exit 1
      fi
      ;;
    desactivar)
      mkdir -p "$CONF"; : >"$CONF/claude-apagado"
      # Sin el servidor MCP «vortex», Claude Code (si lo usas aparte) ya no ve tu pantalla.
      local c
      c="$(command -v claude || echo "$HOME/.local/bin/claude")"
      [[ -x "$c" ]] && "$c" mcp remove --scope user vortex >/dev/null 2>&1
      rm -f "$ESTADO/claude-listo"
      echo "Claude desactivado: Super+A ya no lo abre y no puede ver tu pantalla."
      ;;
    activado)
      if claude_activado; then echo si; else echo no; exit 1; fi
      ;;
    pausa)
      mkdir -p "$CONF"; touch "$pausa"
      echo "Claude ya no puede ver tu pantalla, ventanas ni portapapeles."
      ;;
    reanudar)
      rm -f "$pausa"
      echo "Claude puede volver a ver tu pantalla cuando se lo pidas."
      ;;
    instalar) shift; cmd_claude_instalar "$@" ;;
    estado)
      if [[ -f "$pausa" ]]; then echo "en pausa"; else echo "con acceso (te avisa cada vez que mira)"; fi
      ;;
    "")
      if ! claude_activado; then
        notificar -t 12000 "Claude está apagado" "Actívalo en Ajustes → General → Claude. Necesitas una cuenta de Claude."
        echo "Claude está apagado: actívalo en Ajustes → General → Claude, o con «vortex claude activar»."
        exit 0
      fi
      # El instalador de Claude Code lo deja en ~/.local/bin, que no está en el PATH
      # del escritorio: se agrega aquí para que lo encuentre la terminal que se abre.
      export PATH="$HOME/.local/bin:$PATH"
      local term="${TERMINAL:-kitty}" yo="" orden='claude; exec bash'
      # Vortex: con la ISO, Claude se instala solo en segundo plano (unos 30 s después de entrar, y
      # con red), así que Super+A puede llegar antes, o sin internet. En vez de un «claude: orden no
      # encontrada», la terminal lo termina de instalar y lo abre: si la instalación del inicio sigue
      # en curso espera a que acabe, y si no hay red lo dice. Va el ejecutable de este mismo vortex
      # como $1 (la terminal puede no tenerlo en el PATH).
      if ! command -v claude >/dev/null 2>&1; then
        yo="$(readlink -f "${BASH_SOURCE[0]}")"
        # shellcheck disable=SC2016  # el $1 lo expande bash -lc de la terminal, no este script
        orden='echo "Claude todavía no está instalado: lo instalo ahora…"; "$1" claude instalar && claude; exec bash'
      fi
      if [[ "$term" == kitty ]]; then
        exec kitty --title "Claude · Vortex" --directory "$HOME" bash -lc "$orden" vortex "$yo"
      fi
      exec "$term" -e bash -lc "cd ~; $orden" vortex "$yo"
      ;;
    *) aviso "usa: vortex claude [activar|desactivar|activado|pausa|reanudar|estado|instalar]"; exit 1 ;;
  esac
}

# Java para jugar (Minecraft): ZGC casi no hace pausas (menos tirones) y devuelve al
# sistema la memoria que no usa. Java 27 ya trae las cabeceras de objeto compactas.
JAVA_JUEGOS="-XX:+UseZGC -XX:+DisableExplicitGC -XX:+PerfDisableSharedMem -XX:+UseTransparentHugePages"

# Vortex: heap máximo (-Xmx) según la RAM, en GB. Sin -Xmx la JVM toma 1/4 de la RAM
# (8 GB en 32 GB, 21 GB en 84 GB): ZGC deja crecer el heap hasta ahí y se come RAM que
# el resto del sistema necesita. Minecraft normal va sobrado con 2–4 GB y los modpacks
# grandes con 6; además, fuera del heap el juego usa ~1–2 GB más (LWJGL, Metaspace,
# código compilado), así que se deja al menos la mitad de la RAM al sistema y la GPU.
# Tampoco se baja de 2 GB: con el heap justo, ZGC no termina a tiempo de recolectar y
# el juego espera a que haya memoria («allocation stall»), que es justo un tirón.
#   < 7 GB → 2 GB   < 11 GB → 3 GB   < 22 GB → 4 GB   desde 22 GB → 6 GB
# Se cambia con VORTEX_JAVA_XMX (en GB), p. ej. para un modpack enorme:
#   VORTEX_JAVA_XMX=8 vortex java aplicar
java_xmx_gb() {
  if [[ -n "${VORTEX_JAVA_XMX:-}" ]]; then
    [[ "$VORTEX_JAVA_XMX" =~ ^[1-9][0-9]*$ ]] || { aviso "VORTEX_JAVA_XMX debe ser un número de GB (p. ej. 6)"; exit 1; }
    echo "$VORTEX_JAVA_XMX"; return
  fi
  local mb
  mb=$(($(awk '/^MemTotal:/ {print $2}' /proc/meminfo) / 1024))
  if ((mb < 7000)); then echo 2
  elif ((mb < 11000)); then echo 3
  elif ((mb < 22000)); then echo 4
  else echo 6
  fi
}

cmd_java() {
  case "${1:-}" in
    "")
      local xmx
      xmx="$(java_xmx_gb)"
      echo "Java: $(java -version 2>&1 | head -n1)"
      echo "Memoria sugerida para tu RAM: -Xmx${xmx}G (cámbiala con VORTEX_JAVA_XMX=<GB>)"
      echo "Argumentos para jugar: -Xmx${xmx}G $JAVA_JUEGOS"
      echo "Aplícalos a tus launchers de Minecraft con: vortex java aplicar"
      ;;
    aplicar)
      local hecho=0 f xmx args
      xmx="$(java_xmx_gb)"
      # Vortex: los launchers que guardan -Xmx dentro de los argumentos (oficial,
      # TLauncher) lo pierden al reemplazarlos: va incluido. Si el launcher pone su
      # propio -Xmx después, gana el suyo (la JVM usa el último); nada se rompe.
      args="-Xmx${xmx}G $JAVA_JUEGOS"
      # TLauncher
      f="$HOME/.tlauncher/tlauncher-2.0.properties"
      if [[ -f "$f" ]]; then
        cp -a "$f" "$f.antes-de-vortex"
        if grep -q '^minecraft.javaargs=' "$f"; then
          sed -i "s|^minecraft.javaargs=.*|minecraft.javaargs=$args|" "$f"
        else
          printf 'minecraft.javaargs=%s\n' "$args" >>"$f"
        fi
        echo "TLauncher: listo (respaldo en ${f##*/}.antes-de-vortex)"; hecho=1
      fi
      # Launcher oficial (y los que usan su formato): cada perfil lleva sus argumentos.
      f="$HOME/.minecraft/launcher_profiles.json"
      if [[ -f "$f" ]] && jq -e '.profiles' "$f" >/dev/null 2>&1; then
        cp -a "$f" "$f.antes-de-vortex"
        jq --arg a "$args" '.profiles |= map_values(.javaArgs = $a)' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
        echo "Launcher oficial: listo (respaldo en ${f##*/}.antes-de-vortex)"; hecho=1
      fi
      # Prism Launcher
      f="$HOME/.local/share/PrismLauncher/prismlauncher.cfg"
      if [[ -f "$f" ]]; then
        cp -a "$f" "$f.antes-de-vortex"
        if grep -q '^JvmArgs=' "$f"; then
          sed -i "s|^JvmArgs=.*|JvmArgs=$JAVA_JUEGOS|" "$f"
        else
          printf 'JvmArgs=%s\n' "$JAVA_JUEGOS" >>"$f"
        fi
        # Vortex: Prism pasa su propio -Xmx desde MaxMemAlloc (en MB): se ajusta ahí.
        if grep -q '^MaxMemAlloc=' "$f"; then
          sed -i "s|^MaxMemAlloc=.*|MaxMemAlloc=$((xmx * 1024))|" "$f"
        else
          printf 'MaxMemAlloc=%s\n' "$((xmx * 1024))" >>"$f"
        fi
        # Un mínimo mayor que el nuevo máximo haría fallar el arranque de la JVM.
        local minimo
        minimo="$(sed -n 's/^MinMemAlloc=//p' "$f" | head -n1)"
        if [[ "$minimo" =~ ^[0-9]+$ ]] && ((minimo > xmx * 1024)); then
          sed -i "s|^MinMemAlloc=.*|MinMemAlloc=512|" "$f"
        fi
        echo "Prism Launcher: listo (respaldo en ${f##*/}.antes-de-vortex)"; hecho=1
      fi
      ((hecho)) || echo "No encontré launchers de Minecraft todavía. Cuando instales uno, corre otra vez: vortex java aplicar"
      ;;
    *) aviso "usa: vortex java [aplicar]"; exit 1 ;;
  esac
}

# Vortex: los comandos de bin/ viven como copias en /usr/local/bin (install/30-escritorio.sh; la
# misma lista, pruebas/otaku.sh vigila que no se separen). El shell que trae el repo llama a
# algunos (vortex-otaku), así que se actualizan juntos: tras el pull se copian los que cambiaron.
# El destino se puede cambiar con VORTEX_BIN_DESTINO (las pruebas no tocan el sistema).
COMANDOS_VORTEX=(vortex vortex-bench vortex-mcp vortex-gestor vortex-otaku)

instalar_comandos() {
  local destino="${VORTEX_BIN_DESTINO:-/usr/local/bin}" c
  for c in "${COMANDOS_VORTEX[@]}"; do
    [[ -f "$VORTEX_DIR/bin/$c" ]] || continue
    if cmp -s "$VORTEX_DIR/bin/$c" "$destino/$c"; then continue; fi
    # install borra el destino y crea otro: un vortex que se esté ejecutando sigue con el suyo.
    sudo install -Dm755 "$VORTEX_DIR/bin/$c" "$destino/$c" \
      || aviso "no pude actualizar $destino/$c (a mano: sudo install -Dm755 $VORTEX_DIR/bin/$c $destino/$c)"
  done
}

cmd_actualizar() {
  if [[ -d "$VORTEX_DIR/.git" ]]; then
    # Sin red, sin repo publicado o con historia divergida el pull falla: no debe
    # abortar antes de actualizar los paquetes, ni quedarse pidiendo credenciales.
    GIT_TERMINAL_PROMPT=0 git -C "$VORTEX_DIR" pull --ff-only \
      || aviso "no pude actualizar Vortex (¿sin red o repo sin publicar?); sigo con los paquetes"
  else
    aviso "este Vortex no es un repo git; no puedo actualizarlo"
  fi
  instalar_comandos
  paru -Syu
  # El shell viene de shell/ de este repo: se reconstruye su paquete si cambió.
  local instalado
  instalado="$(pacman -Q vortex-shell 2>/dev/null | awk '{print $2}' | cut -d- -f1)"
  if [[ "$instalado" != "$(cat "$VORTEX_DIR/shell/version.txt")" ]] || [[ "${1:-}" == --forzar ]]; then
    (cd "$VORTEX_DIR/packaging/vortex-shell" && makepkg -sif --noconfirm)
  fi
}

# La config de Vortex para tu usuario (install/usuario.sh), sin instalar nada. La ISO la corre
# en el primer inicio de cada usuario nuevo; sirve también para dejar todo como recién instalado
# (lo que ya existe se respeta, o se respalda si se reemplaza).
cmd_configurar_usuario() {
  [[ -f "$VORTEX_DIR/install/usuario.sh" ]] || { aviso "no encuentro el código de Vortex ($VORTEX_DIR)"; exit 1; }
  export VORTEX_DIR VORTEX_SI=1 VORTEX_DRY_RUN="${VORTEX_DRY_RUN:-0}"
  VORTEX_RESPALDO="$CONF/respaldo-$(date +%Y%m%d-%H%M%S)"
  export VORTEX_RESPALDO
  # shellcheck source=install/lib.sh
  source "$VORTEX_DIR/install/lib.sh"
  # shellcheck source=install/usuario.sh
  source "$VORTEX_DIR/install/usuario.sh"
  if [[ "$VORTEX_DRY_RUN" != 1 ]]; then
    mkdir -p "$CONF"
    cat "$VORTEX_RELEASE" 2>/dev/null | sed -n 's/^VERSION="\(.*\)"$/\1/p' >"$CONF/version"
  fi
  bien "Tu usuario quedó configurado para Vortexine's OS"
}

case "${1:-ayuda}" in
  modo-juego) shift; cmd_modo_juego "$@" ;;
  configurar-usuario) cmd_configurar_usuario ;;
  gestor) shift; cmd_gestor "$@" ;;
  claude) shift; cmd_claude "$@" ;;
  bench) shift; exec "$VORTEX_DIR/bin/vortex-bench" "$@" ;;
  actualizar) shift; cmd_actualizar "$@" ;;
  fondo) shift; cmd_fondo "$@" ;;
  # Vortex: el modo otaku vive en su propio comando (bin/vortex-otaku, copiado en /usr/local/bin).
  otaku)
    shift
    if [[ -x "$VORTEX_DIR/bin/vortex-otaku" ]]; then exec "$VORTEX_DIR/bin/vortex-otaku" "$@"; fi
    exec vortex-otaku "$@"
    ;;
  java) shift; cmd_java "$@" ;;
  primer-inicio) cmd_primer_inicio ;;
  version) cat "$CONF/version" 2>/dev/null || echo "sin instalar (código en $VORTEX_DIR)" ;;
  ayuda | -h | --help) ayuda ;;
  *) aviso "comando desconocido: $1"; ayuda; exit 1 ;;
esac
