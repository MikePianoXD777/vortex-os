def puerto_libre() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def perfil_de(nombre: str) -> Path:
    return NAV_PERFIL if nombre == "firefox" else NAV_PERFIL.with_name(f"{NAV_PERFIL.name}-{nombre}")


def ejecutable_de(nombre: str) -> str | None:
    if os.environ.get("VORTEX_NAVEGADOR_BINARIO"):
        return os.environ["VORTEX_NAVEGADOR_BINARIO"]
    return next((shutil.which(b) for b in NAVEGADORES[nombre][1] if shutil.which(b)), None)


def cli_navegador(argv: list[str]) -> int:
    orden = argv[0] if argv and not argv[0].startswith("--") and argv[0] not in NAVEGADORES and "://" not in argv[0] else "abrir"
    if argv and argv[0] == orden:
        argv = argv[1:]
    if orden == "estado":
        e = leer_estado_navegador()
        print(f"abierto: {e['nombre']} (puerto {e['puerto']})" if e else "cerrado")
        return 0 if e else 1
    if orden == "cerrar":
        e = leer_estado_navegador()
        NAV_ESTADO.unlink(missing_ok=True)
        if not e:
            print("El navegador de Claude no estaba abierto.")
            return 0
        try:
            os.killpg(int(e["pid"]), signal.SIGTERM)
        except OSError:
            try:
                os.kill(int(e["pid"]), signal.SIGTERM)
            except OSError:
                pass
        if e.get("protocolo") == "cdp":
            # Chromium no tiene «borrar al cerrar»: se borra el perfil entero (se rehace al abrir).
            for _ in range(20):
                try:
                    os.kill(int(e["pid"]), 0)
                    time.sleep(0.25)
                except OSError:
                    break
            shutil.rmtree(e.get("perfil") or perfil_de(e["nombre"]), ignore_errors=True)
        shutil.rmtree(carpeta_claude() / ".entrando" / "navegador", ignore_errors=True)
        print("Cerré el navegador de Claude (olvida cookies, almacenamiento e historial).")
        return 0
    if orden != "abrir":
        print("uso: vortex-mcp navegador [abrir] [firefox|brave|chromium|chrome] [--headless] [URL] | cerrar | estado", file=sys.stderr)
        return 2
    if PAUSA.exists():
        print("Claude está en pausa: primero «vortex claude reanudar».", file=sys.stderr)
        return 1
    if leer_estado_navegador():
        print("El navegador de Claude ya está abierto (ciérralo con «vortex claude navegador cerrar» para cambiarlo).")
        return 0
    elegido = next((a for a in argv if a in NAVEGADORES), None)
    if not elegido:
        try:
            elegido = NAV_PREFERIDO.read_text().strip().lower()
        except OSError:
            elegido = ""
        if elegido not in NAVEGADORES:
            elegido = "firefox" if shutil.which("firefox") else next((n for n in NAVEGADORES if ejecutable_de(n)), "firefox")
    protocolo = NAVEGADORES[elegido][0]
    binario = ejecutable_de(elegido)
    if not binario:
        paquete = {"brave": "brave-bin (AUR)", "chromium": "chromium", "chrome": "google-chrome (AUR)"}.get(elegido, elegido)
        print(f"No encuentro {elegido.capitalize()} instalado (paquete: {paquete}).", file=sys.stderr)
        return 1
    headless = "--headless" in argv
    urls = [a for a in argv if not a.startswith("--") and a not in NAVEGADORES]
    if urls and not url_permitida(urls[0]):
        print("Solo abro páginas http o https.", file=sys.stderr)
        return 2
    perfil = perfil_de(elegido)
    # Lo que baje el navegador por su cuenta (antes de que Claude se conecte y las bloquee, o si la persona lo usa
    # a mano) cae en una zona aparte que las herramientas no tocan, nunca directo en la carpeta de Claude.
    aparte = carpeta_claude() / ".entrando" / "navegador"
    shutil.rmtree(aparte, ignore_errors=True)  # lo que quedó de la vez anterior se tira
    aparte.mkdir(parents=True, exist_ok=True)
    os.chmod(aparte.parent, 0o700)
    os.chmod(aparte, 0o700)
    RUNTIME.mkdir(parents=True, exist_ok=True)
    puerto = puerto_libre()
    env = dict(os.environ)
    if protocolo == "bidi":
        perfil.mkdir(parents=True, exist_ok=True)
        (perfil / "user.js").write_text(USER_JS + f'user_pref("browser.download.dir", "{aparte}");\n'
                                        'user_pref("browser.download.folderList", 2);\n')
        (perfil / "chrome").mkdir(exist_ok=True)
        (perfil / "chrome/userChrome.css").write_text(USER_CHROME)
        cmd = [binario, "--new-instance", "--no-remote", "--profile", str(perfil), "--remote-debugging-port", str(puerto),
               "--name", "vortex-claude", "--class", "vortex-claude"]
        if headless:
            cmd.append("--headless")
            env["MOZ_HEADLESS"] = "1"
    else:
        shutil.rmtree(perfil, ignore_errors=True)  # cada vez desde cero: no queda nada de la vez anterior
        (perfil / "Default").mkdir(parents=True)
        os.chmod(perfil, 0o700)
        prefs = json.loads(json.dumps(PREFERENCIAS_CHROMIUM))
        prefs["download"]["default_directory"] = str(aparte)
        (perfil / "Default/Preferences").write_text(json.dumps(prefs))
        (perfil / "First Run").touch()
        cmd = [binario, f"--user-data-dir={perfil}", f"--remote-debugging-port={puerto}", "--remote-debugging-address=127.0.0.1",
               "--no-first-run", "--no-default-browser-check", "--disable-sync", "--password-store=basic", "--enable-automation",
               "--disable-features=Translate,MediaRouter,OptimizationHints,AutofillServerCommunication",
               "--class=vortex-claude", "--new-window"]
        if headless:
            cmd.append("--headless=new")
    cmd.append(urls[0] if urls else "about:blank")
    with open(RUNTIME / "navegador-claude.log", "wb") as log:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, env=env, start_new_session=True)
    limite = time.monotonic() + 40
    while time.monotonic() < limite:
        if p.poll() is not None:
            print(f"{elegido.capitalize()} se cerró al arrancar (mira {RUNTIME / 'navegador-claude.log'}).", file=sys.stderr)
            return 1
        try:
            if protocolo == "cdp":
                with urllib.request.urlopen(f"http://127.0.0.1:{puerto}/json/version", timeout=1):
                    break
            else:
                with socket.create_connection(("127.0.0.1", puerto), timeout=1):
                    break
        except OSError:
            time.sleep(0.3)
    else:
        os.killpg(p.pid, signal.SIGTERM)
        print(f"{elegido.capitalize()} no abrió el control remoto a tiempo.", file=sys.stderr)
        return 1
    NAV_ESTADO.write_text(json.dumps({"pid": p.pid, "puerto": puerto, "perfil": str(perfil), "nombre": elegido,
                                      "protocolo": protocolo, "inicio": time.time()}))
    avisar(f"Abrí un {elegido.capitalize()} aparte para Claude (sin tus cuentas). Ciérralo, o corta todo con «vortex claude pausa».")
    print(f"Listo: el navegador de Claude ({elegido.capitalize()}) está abierto. Ciérralo con «vortex claude navegador cerrar».")
    try:
        cliente = json.loads((RUNTIME / "mcp-cliente.json").read_text())
    except (OSError, ValueError):
        cliente = None
    if not cliente or not cliente.get("elicitation"):
        print("Ojo: lo delicado (bajar ejecutables, subir archivos de otra carpeta o a internet) te lo pregunto con una "
              "notificación con botones" + (", porque tu Claude no sabe preguntar con un cuadro." if cliente else ".")
              + " Si no contestas en un minuto, es que no.")
    return 0


