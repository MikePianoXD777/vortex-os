# --- Protocolo MCP (JSON-RPC 2.0 por líneas) ---

def responder(id_, resultado=None, error=None) -> None:
    msg = {"jsonrpc": "2.0", "id": id_}
    if error:
        msg["error"] = error
    else:
        msg["result"] = resultado
    sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def manejar(msg: dict) -> None:
    if not isinstance(msg, dict):
        responder(None, error={"code": -32600, "message": "Solicitud inválida"})
        return
    metodo, id_, params = msg.get("method"), msg.get("id"), msg.get("params")
    if "method" not in msg:
        return  # una respuesta del cliente que nadie esperaba
    if id_ is None:
        return  # notificación (p. ej. notifications/initialized): no lleva respuesta
    if params is None:
        params = {}
    elif not isinstance(params, dict):
        responder(id_, error={"code": -32602, "message": "«params» debe ser un objeto"})
        return

    if metodo == "initialize":
        pedida = params.get("protocolVersion")
        CLIENTE["confirma"] = isinstance((params.get("capabilities") or {}).get("elicitation"), dict) \
            and not os.environ.get("VORTEX_SIN_ELICITACION")
        guardar_cliente(CLIENTE["confirma"])
        responder(id_, {
            "protocolVersion": pedida if pedida in PROTOCOLOS else PROTOCOLOS[0],
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "vortex", "version": VERSION},
            "instructions": INSTRUCCIONES,
        })
    elif metodo == "ping":
        responder(id_, {})
    elif metodo == "tools/list":
        responder(id_, {"tools": [
            {
                "name": nombre,
                "description": desc,
                "inputSchema": {"type": "object", "properties": props},
                "annotations": {"readOnlyHint": resto[0] if resto else True},
            }
            for nombre, (_, desc, props, *resto) in HERRAMIENTAS.items()
        ]})
    elif metodo == "tools/call":
        nombre = params.get("name")
        if nombre not in HERRAMIENTAS:
            responder(id_, error={"code": -32602, "message": f"Herramienta desconocida: {nombre}"})
            return
        argumentos = params.get("arguments")
        if argumentos is None:
            argumentos = {}
        elif not isinstance(argumentos, dict):
            responder(id_, error={"code": -32602, "message": "«arguments» debe ser un objeto"})
            return
        try:
            contenido = HERRAMIENTAS[nombre][0](argumentos)
            responder(id_, {"content": contenido})
        except Exception as e:  # una herramienta que falla no debe tumbar el servidor
            responder(id_, {"content": [texto(str(e) or type(e).__name__)], "isError": True})
    else:
        responder(id_, error={"code": -32601, "message": f"Método no soportado: {metodo}"})


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "navegador":
        sys.exit(cli_navegador(sys.argv[2:]))
    while (linea := siguiente_mensaje()) is not None:
        linea = linea.strip()
        if not linea:
            continue
        try:
            msg = json.loads(linea)
        except json.JSONDecodeError:
            responder(None, error={"code": -32700, "message": "JSON inválido"})
            continue
        try:
            manejar(msg)
        except Exception as e:  # red de seguridad: nada debe matar el servidor
            id_ = msg.get("id") if isinstance(msg, dict) else None
            if id_ is not None:
                responder(id_, error={"code": -32603, "message": f"Error interno: {e}"})


if __name__ == "__main__":
    main()
