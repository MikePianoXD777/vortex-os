user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("app.update.auto", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("signon.rememberSignons", false);
user_pref("signon.autofillForms", false);
user_pref("extensions.formautofill.addresses.enabled", false);
user_pref("extensions.formautofill.creditCards.enabled", false);
user_pref("privacy.sanitize.sanitizeOnShutdown", true);
user_pref("privacy.clearOnShutdown_v2.cookiesAndStorage", true);
user_pref("privacy.clearOnShutdown_v2.historyFormDataAndDownloads", true);
user_pref("privacy.clearOnShutdown_v2.cache", true);
user_pref("privacy.clearOnShutdown.cookies", true);
user_pref("privacy.clearOnShutdown.history", true);
user_pref("privacy.clearOnShutdown.formdata", true);
user_pref("privacy.clearOnShutdown.sessions", true);
user_pref("privacy.clearOnShutdown.offlineApps", true);
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("remote.active-protocols", 1);
"""

USER_CHROME = """/* Vortexine's OS: que se note que esta ventana la controla Claude. */
#nav-bar { box-shadow: inset 0 -3px 0 #d97757 !important; }
#nav-bar::before {
  content: "Claude puede controlar este navegador · sin tus cuentas · «vortex claude pausa» lo cierra";
  align-self: center; padding: 2px 10px; margin-inline: 6px; border-radius: 6px;
  background: #d97757; color: #1c1c1c; font-weight: 600; font-size: 12px; white-space: nowrap;
}
"""


def puerto_libre() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def cli_navegador(argv: list[str]) -> int:
    orden = argv[0] if argv else "abrir"
    if orden == "estado":
        e = leer_estado_navegador()
        print(f"abierto (puerto {e['puerto']})" if e else "cerrado")
        return 0 if e else 1
    if orden == "cerrar":
        e = leer_estado_navegador()
        NAV_ESTADO.unlink(missing_ok=True)
        if not e:
            print("El navegador de Claude no estaba abierto.")
            return 0
        try:
            os.killpg(int(e["pid"]), signal.SIGTERM)
        except OSError:
            try:
                os.kill(int(e["pid"]), signal.SIGTERM)
            except OSError:
                pass
        print("Cerré el navegador de Claude (olvida cookies, almacenamiento e historial).")
        return 0
    if orden != "abrir":
        print("uso: vortex-mcp navegador [abrir [--headless] [URL]|cerrar|estado]", file=sys.stderr)
        return 2
    if PAUSA.exists():
        print("Claude está en pausa: primero «vortex claude reanudar».", file=sys.stderr)
        return 1
    if leer_estado_navegador():
        print("El navegador de Claude ya está abierto.")
        return 0
    if not shutil.which("firefox"):
        print("Falta Firefox («sudo pacman -S firefox»).", file=sys.stderr)
        return 1
    resto = argv[1:]
    headless = "--headless" in resto
    urls = [a for a in resto if not a.startswith("--")]
    NAV_PERFIL.mkdir(parents=True, exist_ok=True)
    (NAV_PERFIL / "user.js").write_text(USER_JS)
    (NAV_PERFIL / "chrome").mkdir(exist_ok=True)
    (NAV_PERFIL / "chrome/userChrome.css").write_text(USER_CHROME)
    RUNTIME.mkdir(parents=True, exist_ok=True)
    puerto = puerto_libre()
    cmd = ["firefox", "--new-instance", "--no-remote", "--profile", str(NAV_PERFIL), "--remote-debugging-port", str(puerto),
           "--name", "vortex-claude", "--class", "vortex-claude"]
    env = dict(os.environ)
    if headless:
        cmd.append("--headless")
        env["MOZ_HEADLESS"] = "1"
    cmd.append(urls[0] if urls else "about:blank")
    with open(RUNTIME / "navegador-claude.log", "wb") as log:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, env=env, start_new_session=True)
    limite = time.monotonic() + 40
    while time.monotonic() < limite:
        if p.poll() is not None:
            print("Firefox se cerró al arrancar (mira " + str(RUNTIME / "navegador-claude.log") + ").", file=sys.stderr)
            return 1
        try:
            with socket.create_connection(("127.0.0.1", puerto), timeout=1):
                break
        except OSError:
            time.sleep(0.3)
    else:
        p.terminate()
        print("Firefox no abrió el control remoto a tiempo.", file=sys.stderr)
        return 1
    NAV_ESTADO.write_text(json.dumps({"pid": p.pid, "puerto": puerto, "perfil": str(NAV_PERFIL), "inicio": time.time()}))
    avisar("Abrí un Firefox aparte para Claude (sin tus cuentas). Ciérralo, o corta todo con «vortex claude pausa».")
    print("Listo: el navegador de Claude está abierto. Ciérralo con «vortex claude navegador cerrar».")
    return 0


