#!/usr/bin/env bash
# vortex-arreglar (1.9): «Algo no funciona». Revisa lo que más falla y lo explica en palabras simples;
# lo que se puede arreglar solo, lo arregla. Lo usa el panel «Algo no funciona» del shell
# (shell/src/quickshell/arreglar/), y también sirve en la terminal.
#
#   vortex-arreglar              la lista, para leerla
#   vortex-arreglar revisar      la lista en JSON (la lee el panel)
#   vortex-arreglar juego        solo la revisión del último juego de Steam (JSON; nada si no hay registro)
#   vortex-arreglar arreglar ID  sonido | microfono | red | wifi | portal | bluetooth | disco | hora | juego-registro | pacman
#
# Cada revisión: {"id", "titulo", "estado": "bien" | "aviso" | "mal", "detalle", "arreglo": ID o ""}.
# Lo que necesita root (encender el Bluetooth, la hora automática, la caché de pacman, el candado de
# pacman) pasa por pkexec: pide la contraseña con la ventana del shell. Nada se borra de tus archivos.
set -uo pipefail
export LC_ALL=C

SYS="${VORTEX_SYS:-/sys}"
CANDADO="${VORTEX_RAIZ:-}/var/lib/pacman/db.lck"
STEAM="${VORTEX_STEAM:-$HOME/.local/share/Steam}"
JUEGO_CORTO=60         # s: un juego que dura menos, quizá no abrió
JUEGO_RECIENTE=21600   # s: lo de hace más de 6 h ya no se menciona

item() { # ID TITULO ESTADO DETALLE [ARREGLO]
  jq -cn --arg id "$1" --arg titulo "$2" --arg estado "$3" --arg detalle "$4" --arg arreglo "${5:-}" \
    '{id: $id, titulo: $titulo, estado: $estado, detalle: $detalle, arreglo: $arreglo}'
}

volumen() { # @DEFAULT_SINK@ | @DEFAULT_SOURCE@ → el % del primer canal
  local tipo=sink
  [[ "$1" == *SOURCE* ]] && tipo=source
  pactl "get-$tipo-volume" "$1" 2>/dev/null | grep -o '[0-9]*%' | head -n1 | tr -d %
}

# ---- Revisiones -----------------------------------------------------------------------------------

rev_sonido() {
  command -v pactl >/dev/null || return 0
  if ! pactl info >/dev/null 2>&1; then
    item sonido "Sonido" mal "El sistema de sonido no responde." sonido
    return
  fi
  local sink nombre
  sink="$(pactl get-default-sink 2>/dev/null)"
  if [[ -z "$sink" || "$sink" == auto_null ]]; then
    item sonido "Sonido" mal "No se encuentra ninguna salida de sonido (bocinas o audífonos)." sonido
    return
  fi
  nombre="$(pactl -f json list sinks 2>/dev/null | jq -r --arg n "$sink" '.[] | select(.name == $n) | .description' 2>/dev/null)"
  nombre="${nombre:-$sink}"
  if pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'yes'; then
    item sonido "Sonido" mal "Está silenciado ($nombre)." sonido
  elif [[ "$(volumen @DEFAULT_SINK@)" == 0 ]]; then
    item sonido "Sonido" mal "El volumen está en 0 ($nombre)." sonido
  else
    item sonido "Sonido" bien "Sale por: $nombre, al $(volumen @DEFAULT_SINK@) %."
  fi
}

rev_microfono() {
  command -v pactl >/dev/null && pactl info >/dev/null 2>&1 || return 0
  local src
  src="$(pactl get-default-source 2>/dev/null)"
  if [[ -z "$src" || "$src" == *.monitor || "$src" == auto_null ]]; then
    item microfono "Micrófono" aviso "No hay ningún micrófono conectado."
  elif pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -q 'yes'; then
    item microfono "Micrófono" mal "Está silenciado." microfono
  elif [[ "$(volumen @DEFAULT_SOURCE@)" == 0 ]]; then
    item microfono "Micrófono" mal "Su volumen está en 0." microfono
  else
    item microfono "Micrófono" bien "Funciona, al $(volumen @DEFAULT_SOURCE@) %."
  fi
}

# Tipo (wlan, bluetooth) bloqueado: «soft» (apagado desde el sistema) o «hard» (tecla o botón).
bloqueado() { # TIPO soft|hard
  local r
  for r in "$SYS"/class/rfkill/rfkill*; do
    [[ -f "$r/type" && "$(cat "$r/type")" == "$1" && "$(cat "$r/$2" 2>/dev/null)" == 1 ]] && return 0
  done
  return 1
}

rev_internet() {
  command -v nmcli >/dev/null || return 0
  if [[ "$(nmcli networking 2>/dev/null)" != enabled ]]; then
    item internet "Internet" mal "La red está apagada." red
    return
  fi
  local estado conectada
  estado="$(nmcli networking connectivity check 2>/dev/null || nmcli networking connectivity 2>/dev/null)"
  conectada="$(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null | awk -F: '($1 == "ethernet" || $1 == "wifi") && $2 == "connected" {print $3; exit}')"
  case "$estado" in
    full) item internet "Internet" bien "Conectado${conectada:+ a «$conectada»}." ;;
    portal) item internet "Internet" aviso "Esta red pide iniciar sesión (hotel, escuela, café): ábrela en el navegador." portal ;;
    *)
      if [[ -n "$conectada" ]]; then
        item internet "Internet" mal "Conectado a «$conectada», pero sin internet." red
      elif bloqueado wlan hard; then
        item internet "Internet" mal "El Wi-Fi está apagado con la tecla o el botón del equipo (busca el ícono de antena o avión)."
      elif [[ -d "$SYS/class/ieee80211" && -n "$(ls -A "$SYS/class/ieee80211" 2>/dev/null)" ]] &&
        { [[ "$(nmcli radio wifi 2>/dev/null)" != enabled ]] || bloqueado wlan soft; }; then
        item internet "Internet" mal "El Wi-Fi está apagado." wifi
      else
        item internet "Internet" mal "No estás conectado a ninguna red: elige tu Wi-Fi o conecta el cable." elegir-red
      fi
      ;;
  esac
}

rev_bluetooth() {
  [[ -n "$(ls -A "$SYS/class/bluetooth" 2>/dev/null)" ]] || return 0
  if bloqueado bluetooth hard; then
    item bluetooth "Bluetooth" mal "Está apagado con la tecla o el botón del equipo."
  elif ! systemctl is-active --quiet bluetooth 2>/dev/null; then
    item bluetooth "Bluetooth" mal "El servicio de Bluetooth está apagado." bluetooth
  elif bloqueado bluetooth soft; then
    item bluetooth "Bluetooth" mal "Está apagado." bluetooth
  else
    item bluetooth "Bluetooth" bien "Encendido."
  fi
}

rev_disco() {
  local uso libre
  read -r uso libre < <(df -P "$HOME" 2>/dev/null | awk 'NR == 2 {gsub("%", "", $5); printf "%s %.1f\n", $5, $4 / 1048576}')
  [[ "$uso" =~ ^[0-9]+$ ]] || return 0
  if ((uso >= 95)); then
    item disco "Disco" mal "Está casi lleno: quedan $libre GB. Con el disco lleno fallan las actualizaciones y las apps." disco
  elif ((uso >= 90)); then
    item disco "Disco" aviso "Se está llenando: quedan $libre GB." disco
  else
    item disco "Disco" bien "Quedan $libre GB libres ($uso % usado)."
  fi
}

rev_hora() {
  command -v timedatectl >/dev/null || return 0
  if [[ "$(timedatectl show -p NTP --value 2>/dev/null)" == no ]]; then
    item hora "Fecha y hora" mal "La hora no se pone sola: si está mal, fallan las páginas seguras y las actualizaciones." hora
  else
    item hora "Fecha y hora" bien "Se pone sola por internet."
  fi
}

rev_actualizaciones() {
  [[ -e "$CANDADO" ]] || { item pacman "Actualizaciones" bien "Nada trabado."; return; }
  if pgrep -x 'pacman|paru|yay|pamac' >/dev/null 2>&1; then
    item pacman "Actualizaciones" aviso "Se está instalando algo ahora mismo: espera a que termine."
  else
    item pacman "Actualizaciones" mal "Una actualización quedó a medias y no deja instalar nada más." pacman
  fi
}

rev_servicios() {
  local fallas
  fallas="$({ systemctl --failed --no-legend --plain 2>/dev/null; systemctl --user --failed --no-legend --plain 2>/dev/null; } |
    awk '{print $1}' | grep -v '^$' | sed 's/\.service$//' | sort -u | paste -sd, - | sed 's/,/, /g')"
  [[ -n "$fallas" ]] && item servicios "Servicios" aviso "Fallaron al arrancar: $fallas. Si algo no funciona, reinicia el equipo."
  return 0
}

# ---- «Este juego no abre» (2.7) ---------------------------------------------------------------------
# Steam anota en gameprocess_log.txt cuándo abre y cierra cada juego. Si el último duró menos de un minuto
# y hace poco, se busca la causa en lo que dejó y se explica en español. Por ahora solo juegos de Steam.

# La última sesión: «APPID INICIO FIN» (FIN vacío si el juego sigue abierto); nada si no hay registro.
ultima_sesion() {
  local registro="$STEAM/logs/gameprocess_log.txt" a inicio fin
  [[ -r "$registro" ]] || return 0
  read -r a inicio fin < <(tail -n 4000 "$registro" | awk '
    function hora(l) { return substr(l, 2, 19) }
    match($0, /AppID [0-9]+ adding PID/) {
      if (id == "") { split(substr($0, RSTART, RLENGTH), p, " "); id = p[2]; ini = hora($0) }
    }
    /Remove [0-9]+ from running list/ {
      for (i = 1; i <= NF; i++) if ($i == "Remove") r = $(i + 1)
      if (r == id) { ult = id "\t" ini "\t" hora($0); id = "" }
    }
    END { if (id != "") print id "\t" ini "\t"; else if (ult != "") print ult }' | tr ' ' '_' | tr '\t' ' ')
  [[ -n "${a:-}" ]] || return 0
  inicio="$(date -d "${inicio/_/ }" +%s 2>/dev/null)" || return 0
  [[ -n "${fin:-}" ]] && { fin="$(date -d "${fin/_/ }" +%s 2>/dev/null)" || fin=""; }
  echo "$a $inicio ${fin:-}"
}

# El manifiesto del juego, en la biblioteca donde esté instalado.
manifiesto() { # APPID
  local carpeta f
  while read -r carpeta; do
    f="$carpeta/steamapps/appmanifest_$1.acf"
    [[ -r "$f" ]] && { echo "$f"; return 0; }
  done < <(echo "$STEAM"; sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"$/\1/p' "$STEAM/steamapps/libraryfolders.vdf" 2>/dev/null)
  return 1
}
campo_acf() { sed -n "s/^[[:space:]]*\"$2\"[[:space:]]*\"\(.*\)\"$/\1/p" "$1" | head -n1; } # ARCHIVO CAMPO

# La causa, en una línea: «ESTADO<tab>TEXTO<tab>ARREGLO»; nada si no se encontró.
causa_juego() { # APPID INICIO FIN
  local id="$1" inicio="$2" fin="$3" modulo version acf carpeta dll log libre traza
  # Driver actualizado sin reiniciar: el más común y el que más desconcierta
  if [[ -r "$SYS/module/nvidia/version" ]]; then
    modulo="$(cat "$SYS/module/nvidia/version")"
    version="$(pacman -Q nvidia-utils 2>/dev/null | awk '{print $2}' | sed 's/^[0-9]*://; s/-[^-]*$//')"
    if [[ -n "$version" && "$modulo" != "$version" ]]; then
      printf 'mal\tSe actualizó el driver de NVIDIA y falta reiniciar: reinicia el equipo y vuelve a abrirlo.\t\n'
      return
    fi
  fi
  libre="$(df -P "$HOME" 2>/dev/null | awk 'NR == 2 {print int($4 / 1024)}')"
  if [[ "$libre" =~ ^[0-9]+$ ]] && ((libre < 1024)); then
    printf 'mal\tCasi no queda disco (%s MB) y los juegos no arrancan así.\tdisco\n' "$libre"
    return
  fi
  if journalctl -k --no-pager -q --since "@$inicio" --until "@$((fin + 5))" -g 'oom-kill|out of memory' -n 1 2>/dev/null | grep -q .; then
    printf 'mal\tSe quedó sin memoria: cierra otras apps (navegador, Discord) y vuelve a abrirlo.\t\n'
    return
  fi
  if journalctl -k --no-pager -q --since "@$inicio" --until "@$((fin + 5))" -g 'NVRM: Xid' -n 1 2>/dev/null | grep -q .; then
    printf 'mal\tLa tarjeta de video dio un error mientras abría: reinicia el equipo y vuelve a intentar.\t\n'
    return
  fi
  # El registro de Proton existe solo si se abrió «con registro» (o tienes PROTON_LOG puesto)
  log="$HOME/steam-$id.log"
  if [[ -r "$log" ]] && (($(stat -c %Y "$log") >= inicio)); then
    dll="$(grep -aoE 'err:module:import_dll Library [^ ]+\.[dD][lL][lL]' "$log" | awk '{print $3}' | sort -u | head -n1)"
    if [[ -n "$dll" ]]; then
      case "${dll,,}" in
        vcruntime* | msvcp* | msvcr* | ucrtbase*) dll="$dll (de Visual C++)" ;;
        d3dx* | d3dcompiler* | xinput* | xaudio* | x3daudio*) dll="$dll (de DirectX)" ;;
        mscoree*) dll="$dll (de .NET)" ;;
      esac
      printf 'mal\tLe falta %s. En Steam: Propiedades → Compatibilidad, prueba otra versión de Proton.\t\n' "$dll"
      return
    fi
    if grep -aqE 'VK_ERROR_INCOMPATIBLE_DRIVER|No adapters found|vkCreateInstance failed' "$log"; then
      printf 'mal\tNo pudo usar la tarjeta de video (Vulkan): reinicia el equipo; si sigue, corre «vortex actualizar».\t\n'
      return
    fi
    if grep -aqE 'E_OUTOFMEMORY|std::bad_alloc|[Oo]ut of memory' "$log"; then
      printf 'mal\tSe quedó sin memoria: cierra otras apps y vuelve a abrirlo.\t\n'
      return
    fi
    if grep -aqE 'wine: Unhandled|EXCEPTION_ACCESS_VIOLATION|Unhandled exception' "$log"; then
      printf 'mal\tEl juego tronó al arrancar. En Steam: Propiedades → Archivos instalados → Verificar; si sigue, prueba otra versión de Proton.\t\n'
      return
    fi
  fi
  # Un juego de Linux que tronó deja un volcado, con su ruta dentro de steamapps/common
  traza="$(coredumpctl list --no-pager --no-legend -q --since "@$inicio" --until "@$((fin + 10))" 2>/dev/null | grep -F 'steamapps/common' | tail -n1)"
  if [[ -n "$traza" ]]; then
    printf 'mal\tEl juego tronó al arrancar. En Steam: Propiedades → Archivos instalados → Verificar.\t\n'
    return
  fi
  if acf="$(manifiesto "$id")"; then
    carpeta="$(dirname "$acf")/common/$(campo_acf "$acf" installdir)"
    if [[ -d "$carpeta/EasyAntiCheat" || -d "$carpeta/BattlEye" || -d "$carpeta/EasyAntiCheat_EOS" ]]; then
      printf 'aviso\tUsa anti-trampas y puede que no acepte Linux: búscalo en areweanticheatyet.com.\t\n'
      return
    fi
  fi
}

rev_juego() {
  local sesion id inicio fin acf nombre duro causa estado texto arreglo
  sesion="$(ultima_sesion)"
  [[ -n "$sesion" ]] || return 0
  read -r id inicio fin <<<"$sesion"
  [[ -n "${fin:-}" ]] || return 0 # sigue abierto: nada que decir
  nombre="el juego $id"
  acf="$(manifiesto "$id")" && nombre="«$(campo_acf "$acf" name)»"
  duro=$((fin - inicio))
  if ((duro >= JUEGO_CORTO || $(date +%s) - fin > JUEGO_RECIENTE)); then
    item juego "Juegos" bien "El último, $nombre, abrió bien."
    return
  fi
  causa="$(causa_juego "$id" "$inicio" "$fin")"
  if [[ -n "$causa" ]]; then
    IFS=$'\t' read -r estado texto arreglo <<<"$causa"
    item juego "Juegos" "$estado" "$nombre se cerró a los $duro s. $texto" "$arreglo"
  else
    item juego "Juegos" aviso "$nombre se cerró a los $duro s y no dejó la causa. Si no abrió, ábrelo con registro para averiguarla (Steam se reinicia); si lo cerraste tú, ignora esto." juego-registro
  fi
}

# Steam hereda PROTON_LOG y se lo pasa al juego: por eso hay que cerrarlo y abrirlo otra vez.
juego_con_registro() {
  local sesion id inicio fin _
  sesion="$(ultima_sesion)"
  read -r id inicio fin <<<"$sesion"
  [[ -n "${id:-}" ]] || { echo "No encontré ningún juego de Steam."; return 1; }
  [[ -n "${fin:-}" ]] || { echo "Ese juego sigue abierto: ciérralo primero."; return 1; }
  command -v steam >/dev/null || { echo "No encontré Steam."; return 1; }
  if pgrep -x steam >/dev/null 2>&1; then
    steam -shutdown >/dev/null 2>&1
    for _ in {1..30}; do pgrep -x steam >/dev/null 2>&1 || break; sleep 1; done
    pgrep -x steam >/dev/null 2>&1 && { echo "Steam no se cerró: ciérralo tú y vuelve a intentar."; return 1; }
  fi
  PROTON_LOG=1 setsid -f steam "steam://rungameid/$id" </dev/null >/dev/null 2>&1
  echo "Abriendo el juego con registro. Cuando se cierre, dale «Revisar otra vez»."
}

revisar() {
  { rev_sonido; rev_microfono; rev_internet; rev_bluetooth; rev_disco; rev_hora; rev_actualizaciones; rev_servicios; rev_juego; } |
    jq -s '.'
}

# ---- Arreglos -------------------------------------------------------------------------------------

arreglar() {
  case "$1" in
    sonido)
      if ! pactl info >/dev/null 2>&1 || [[ "$(pactl get-default-sink 2>/dev/null)" =~ ^(|auto_null)$ ]]; then
        systemctl --user restart wireplumber pipewire pipewire-pulse 2>/dev/null
        local _
        for _ in 1 2 3 4 5 6; do pactl info >/dev/null 2>&1 && break; sleep 0.5; done
        sleep 1
      fi
      pactl set-sink-mute @DEFAULT_SINK@ 0 2>/dev/null
      [[ "$(volumen @DEFAULT_SINK@)" == 0 ]] && pactl set-sink-volume @DEFAULT_SINK@ 50% 2>/dev/null
      ;;
    microfono)
      pactl set-source-mute @DEFAULT_SOURCE@ 0 2>/dev/null
      [[ "$(volumen @DEFAULT_SOURCE@)" == 0 ]] && pactl set-source-volume @DEFAULT_SOURCE@ 80% 2>/dev/null
      ;;
    red)
      nmcli networking off 2>/dev/null
      sleep 2
      nmcli networking on 2>/dev/null
      sleep 5
      ;;
    wifi)
      bloqueado wlan soft && rfkill unblock wlan 2>/dev/null
      nmcli radio wifi on 2>/dev/null
      sleep 4
      ;;
    portal) setsid -f xdg-open "http://neverssl.com" >/dev/null 2>&1 ;;
    elegir-red) hyprctl dispatch 'hl.dsp.event("serpantinum:toggle network")' >/dev/null 2>&1 ;;
    bluetooth)
      bloqueado bluetooth soft && rfkill unblock bluetooth 2>/dev/null
      systemctl is-active --quiet bluetooth || pkexec systemctl enable --now bluetooth
      ;;
    hora) pkexec timedatectl set-ntp true ;;
    juego-registro) juego_con_registro ;;
    pacman)
      pgrep -x 'pacman|paru|yay|pamac' >/dev/null 2>&1 && { echo "Hay una instalación corriendo: espera a que termine." >&2; return 1; }
      pkexec rm -f "$CANDADO"
      ;;
    disco)
      # Lo tuyo no se toca: cachés que se rehacen solas, apps de Flatpak que nadie usa y, con tu
      # contraseña, la caché de pacman (deja la versión instalada) y los registros viejos del sistema.
      local antes despues
      antes="$(df -P --output=avail "$HOME" | tail -n1)"
      rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/thumbnails" 2>/dev/null
      command -v flatpak >/dev/null && flatpak uninstall --unused -y --noninteractive >/dev/null 2>&1
      pkexec sh -c 'command -v paccache >/dev/null && paccache -rk1 -q; paccache -ruk0 -q 2>/dev/null; journalctl --vacuum-size=200M -q' >/dev/null 2>&1
      despues="$(df -P --output=avail "$HOME" | tail -n1)"
      awk -v a="$antes" -v d="$despues" 'BEGIN {l = (d - a) / 1048576; if (l < 0) l = 0; printf "Se liberaron %.1f GB.\n", l}'
      ;;
    *) echo "uso: vortex-arreglar arreglar sonido|microfono|red|wifi|portal|elegir-red|bluetooth|disco|hora|juego-registro|pacman" >&2; return 2 ;;
  esac
}

case "${1:-}" in
  revisar) revisar ;;
  juego) rev_juego ;;
  arreglar) arreglar "${2:-}" ;;
  "")
    revisar | jq -r '.[] | (if .estado == "bien" then "✓" elif .estado == "aviso" then "!" else "✗" end) + " " + .titulo + ": " + .detalle
      + (if .arreglo != "" and .estado != "bien" then "   (vortex-arreglar arreglar " + .arreglo + ")" else "" end)'
    ;;
  *) echo "uso: vortex-arreglar [revisar | juego | arreglar ID]" >&2; exit 2 ;;
esac
