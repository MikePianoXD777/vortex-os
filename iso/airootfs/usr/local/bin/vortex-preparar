#!/usr/bin/env bash
# vortex-preparar [raíz [partición]]: copia Vortex OS a un Arch recién instalado y deja que su
# instalador corra solo la primera vez que el usuario entra en la consola (tty1).
set -euo pipefail

RAIZ="${1:-/mnt}"
ORIGEN=/root/vortex-os

# Algunas versiones de archinstall montan el sistema en /mnt/archinstall.
[[ ! -f "$RAIZ/etc/arch-release" && -f "$RAIZ/archinstall/etc/arch-release" ]] && RAIZ="$RAIZ/archinstall"

# Monta la raíz de la partición $1 en $2 (tipo $3; btrfs: subvolumen @ si existe).
# $4 son opciones extra de mount (el sondeo usa «ro» para no tocar sistemas ajenos).
montar_raiz() {
  local extra="${4:+$4,}"
  case "$3" in
    btrfs) mount -o "${extra}subvol=@" "$1" "$2" 2>/dev/null || mount ${4:+-o "$4"} "$1" "$2" 2>/dev/null ;;
    ext4 | xfs | f2fs) mount ${4:+-o "$4"} "$1" "$2" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

# Si archinstall ya desmontó el disco hay que volver a montarlo. NO se adivina cuál
# es: otro Arch/CachyOS en otro disco también tiene /etc/arch-release y Vortex se
# instalaría encima de un sistema ajeno. Se muestran las candidatas y se elige (o se
# pasa la partición como segundo argumento: vortex-preparar /mnt /dev/sdb2).
if [[ ! -f "$RAIZ/etc/arch-release" ]]; then
  PARTICION="${2:-}"
  if [[ -z "$PARTICION" ]]; then
    prueba="$(mktemp -d)"
    # Si algo falla a mitad del sondeo (o Ctrl-C) no se deja nada montado.
    trap 'umount "$prueba" 2>/dev/null || true; rmdir "$prueba" 2>/dev/null || true' EXIT
    candidatas=() descripciones=() luks=()
    while read -r part tipo; do
      [[ "$tipo" == crypto_LUKS ]] && luks+=("$part")
      # Solo lectura: son sistemas que quizá no son nuestros, no se tocan.
      montar_raiz "$part" "$prueba" "$tipo" ro || continue
      if [[ -f "$prueba/etc/arch-release" ]]; then
        # Se lee sin ejecutarlo: el archivo es de un disco ajeno.
        nombre="$(sed -n 's/^PRETTY_NAME=//p' "$prueba/etc/os-release" 2>/dev/null | head -n1 | tr -d '"' || true)"
        candidatas+=("$part")
        descripciones+=("$part ($tipo): ${nombre:-Arch Linux}")
      fi
      umount "$prueba" || { echo "No pude desmontar $prueba." >&2; exit 1; }
    done < <(lsblk -lnpo NAME,FSTYPE | awk 'NF == 2')
    rmdir "$prueba"
    trap - EXIT

    if ((${#candidatas[@]} == 0)); then
      if ((${#luks[@]})); then
        echo "No encontré el Arch instalado: el disco parece cifrado (LUKS: ${luks[*]})." >&2
        echo "Ábrelo y móntalo en $RAIZ (cryptsetup open …; mount /dev/mapper/… $RAIZ) y vuelve a correr vortex-preparar" >&2
        echo "(o indica el volumen abierto: vortex-preparar $RAIZ /dev/mapper/<nombre>)." >&2
      else
        echo "No encontré el Arch instalado." >&2
      fi
      exit 1
    fi
    if [[ ! -t 0 ]]; then
      echo "El disco no está montado en $RAIZ y no puedo preguntarte cuál es. Indícalo: vortex-preparar $RAIZ /dev/…" >&2
      printf '  candidata: %s\n' "${descripciones[@]}" >&2
      exit 1
    fi
    echo "El sistema recién instalado no está montado en $RAIZ. Sistemas Arch encontrados:"
    for i in "${!descripciones[@]}"; do echo "  $((i + 1))) ${descripciones[i]}"; done
    read -r -p "¿Cuál es el que acabas de instalar? (número, Enter cancela) " n || n=""
    [[ "$n" =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#candidatas[@]})) || { echo "Cancelado." >&2; exit 1; }
    PARTICION="${candidatas[n - 1]}"
  fi
  mkdir -p "$RAIZ"
  montar_raiz "$PARTICION" "$RAIZ" "$(lsblk -no FSTYPE "$PARTICION" | head -n1)" || { echo "No pude montar $PARTICION en $RAIZ." >&2; exit 1; }
  # Lo que montamos nosotros lo desmontamos al terminar.
  trap 'umount -R "$RAIZ" 2>/dev/null || true' EXIT
  # /home suele ser otro subvolumen (@home) o partición: se monta según el fstab del
  # sistema instalado, para que la copia no quede tapada al arrancar.
  mount -T "$RAIZ/etc/fstab" --target-prefix "$RAIZ" /home 2>/dev/null || true
fi
[[ -f "$RAIZ/etc/arch-release" ]] || { echo "No encontré el Arch instalado." >&2; exit 1; }

# El usuario normal que creó archinstall (el primero con UID ≥ 1000).
usuario="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' "$RAIZ/etc/passwd")"
[[ -n "$usuario" ]] || { echo "No hay ningún usuario normal en el sistema instalado." >&2; exit 1; }
casa="$(awk -F: -v u="$usuario" '$1 == u {print $6}' "$RAIZ/etc/passwd")"
uid_gid="$(awk -F: -v u="$usuario" '$1 == u {print $3":"$4}' "$RAIZ/etc/passwd")"

# La casa la crea archinstall; si no existe aquí es que falta montarla (no inventarla).
[[ -d "$RAIZ$casa" ]] || { echo "No existe $RAIZ$casa: monta /home del sistema instalado y reintenta." >&2; exit 1; }
destino="$RAIZ$casa/.local/share/vortex-os"
mkdir -p "$destino"
cp -a "$ORIGEN/." "$destino/"
# Refuerzo: construir.sh ya deja los permisos, pero así el instalador corre aunque se perdieran.
(cd "$destino" && chmod +x install.sh boot.sh bin/* vm/*.sh 2>/dev/null || true)
touch "$destino/.pendiente"
chown -R "$uid_gid" "$RAIZ$casa/.local"

# Primer inicio de sesión en tty1: corre el instalador una vez.
install -Dm644 /dev/stdin "$RAIZ/etc/profile.d/vortex-primer-inicio.sh" <<'EOF'
# Vortex OS: termina la instalación la primera vez que entras en la consola.
if [ -f "$HOME/.config/vortex/version" ]; then
  # install/90-final.sh escribe esta marca ANTES de preguntar «¿Reiniciar ahora?»: si existe, la
  # instalación terminó aunque el reinicio haya matado la sesión antes de limpiar .pendiente.
  rm -f "$HOME/.local/share/vortex-os/.pendiente"
else
  # Solo shells interactivos: greetd arranca cada sesión con «sh -c … /etc/profile …» sobre /dev/tty1
  # (no interactivo) y ahí no debe correr el instalador, solo en el login de consola.
  case $- in
    *i*)
      if [ "$(tty)" = /dev/tty1 ] && [ -f "$HOME/.local/share/vortex-os/.pendiente" ]; then
        # Con NetworkManager se espera a la red (wifi) antes de instalar.
        if command -v nm-online >/dev/null 2>&1 && ! nm-online -q -t 30; then
          echo "Sin red: conéctate con «nmtui» y vuelve a entrar para terminar la instalación de Vortex."
        elif "$HOME/.local/share/vortex-os/install.sh" && [ -f "$HOME/.config/vortex/version" ]; then
          # Se comprueba la marca y no solo el código de salida; .pendiente solo se borra si terminó bien.
          rm -f "$HOME/.local/share/vortex-os/.pendiente"
        else
          echo "La instalación de Vortex falló. Se reintentará al volver a entrar, o corre: ~/.local/share/vortex-os/install.sh"
        fi
      fi
      ;;
  esac
fi
EOF

echo "Vortex OS quedará instalado para «$usuario» en su primer inicio de sesión."
