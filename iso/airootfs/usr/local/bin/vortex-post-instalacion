#!/usr/bin/env bash
# vortex-post-instalacion: lo corre Calamares dentro del sistema recién copiado al disco.
#
#   vortex-post-instalacion kernel          antes de generar el initramfs
#   vortex-post-instalacion final USUARIO   al final, antes del gestor de arranque
#   vortex-post-instalacion arranque        después del gestor de arranque (entradas «Vortex OS»)
#   vortex-post-instalacion inicio-automatico USUARIO   entra solo al escritorio (lo llama «final»)
#
# La imagen del USB es Vortex completo, pero trae piezas que solo sirven para arrancar desde
# el USB (hooks de archiso, el usuario live, el instalador). Aquí se quitan y se hace lo que
# install.sh decide según el equipo: drivers de la GPU (chwd), Bluetooth y systemd-oomd.
set -uo pipefail

log() { printf 'vortex-post-instalacion: %s\n' "$*"; }

paso_kernel() {
  # Sin los hooks de archiso; los pasos initcpiocfg e initcpio de Calamares arman el normal.
  rm -f /etc/mkinitcpio.conf.d/archiso.conf
  # mkarchiso deja /boot vacío (el kernel del USB va aparte): cada kernel instalado vuelve a
  # /boot desde /usr/lib/modules, con su preset de mkinitcpio.
  local vmlinuz dir pkgbase preset
  for vmlinuz in /usr/lib/modules/*/vmlinuz; do
    dir="${vmlinuz%/vmlinuz}"
    read -r pkgbase <"$dir/pkgbase" 2>/dev/null || continue
    install -Dm644 "$vmlinuz" "/boot/vmlinuz-$pkgbase"
    preset="/etc/mkinitcpio.d/$pkgbase.preset"
    if [[ ! -e "$preset" ]]; then
      sed "s|%PKGBASE%|$pkgbase|g" /usr/share/mkinitcpio/hook.preset | install -Dm644 /dev/stdin "$preset"
    fi
    log "kernel $pkgbase en /boot"
  done
}

paso_final() {
  local usuario="${1:-}"

  # --- Lo que es solo del USB ---
  rm -f /etc/systemd/system/multi-user.target.wants/vortex-live.service \
    /etc/systemd/system/vortex-live.service \
    /etc/systemd/system/multi-user.target.wants/pacman-init.service \
    /etc/systemd/system/pacman-init.service \
    /etc/systemd/system/etc-pacman.d-gnupg.mount \
    /usr/local/bin/vortex-live /usr/local/bin/vortex-instalador \
    /usr/share/applications/vortex-instalar.desktop \
    /etc/vortex/live \
    /etc/systemd/system-preset/05-vortex-live.preset \
    /etc/systemd/system/systemd-firstboot.service
  rm -rf /etc/calamares
  # Calamares y lo que solo usa el arranque del USB (sus dependencias de KDE se van con él).
  local sobran=()
  for p in calamares ckbcomp os-prober mkinitcpio-archiso; do
    pacman -Qq "$p" >/dev/null 2>&1 && sobran+=("$p")
  done
  ((${#sobran[@]})) && { pacman -Rns --noconfirm "${sobran[@]}" || log "no pude quitar ${sobran[*]}"; }

  # --- Drivers de la GPU (como install.sh): NVIDIA, AMD, Intel, híbridas ---
  if command -v chwd >/dev/null; then
    chwd -a || log "chwd no pudo instalar los drivers (¿sin internet?): luego, «sudo chwd -a»"
  fi

  # --- Servicios según el equipo (como install/20-sistema.sh) ---
  if [[ -d /sys/class/bluetooth && -n "$(ls -A /sys/class/bluetooth 2>/dev/null)" ]]; then
    systemctl enable bluetooth.service
  fi
  # scx_lavd ya reparte la CPU: las reglas de ananicy sobran.
  systemctl disable ananicy-cpp.service 2>/dev/null || true
  # systemd-oomd ayuda con poca RAM: se queda en equipos de menos de 8 GB.
  if (($(awk '/MemTotal/ {print int($2 / 1024)}' /proc/meminfo) >= 8000)); then
    systemctl disable systemd-oomd.service systemd-oomd.socket 2>/dev/null || true
  fi

  # --- Ese usuario: su grupo de gamemode (prioridad al jugar) ---
  if [[ -n "$usuario" ]] && id "$usuario" >/dev/null 2>&1; then
    getent group gamemode >/dev/null && usermod -aG gamemode "$usuario"
  fi

  # --- Inicio de sesión automático, si marcó la casilla de la pantalla «Usuarios» ---
  paso_inicio_automatico "$usuario"
  log "listo"
}

# La casilla «Iniciar sesión automáticamente» de Calamares (módulo users) no llega a greetd por
# sí sola, y shellprocess no puede leerla de forma segura: ${gs[autoLoginUser]} solo existe con la
# casilla marcada, y una variable que falta hace fallar todo el paso (se cancelaría la instalación
# de quien no la marcó); los booleanos tampoco se pueden leer con ${gs[...]}. Lo que sí deja es
# el grupo de users_vortex.conf (autologinGroup): con la casilla marcada, Calamares crea el grupo
# «autologin» y mete en él a ese usuario; sin marcarla no hace ninguna de las dos cosas. Así que
# aquí se mira si el usuario es de ese grupo, y entonces greetd (que ya trae vortex-sesion en
# la sesión normal) recibe un [initial_session] para él. Al cerrar la sesión vuelve tuigreet.
# Es lo mismo que hace vortex-live para el usuario del live.
paso_inicio_automatico() {
  local usuario="${1:-}" grupo="${VORTEX_GRUPO_AUTOLOGIN:-autologin}"
  local raiz="${VORTEX_RAIZ:-}" cfg tmp
  cfg="$raiz/etc/greetd/config.toml"
  [[ -n "$usuario" ]] || return 0
  getent group "$grupo" >/dev/null 2>&1 || return 0   # nadie marcó la casilla
  id -nG "$usuario" 2>/dev/null | tr ' ' '\n' | grep -qx -- "$grupo" || return 0
  # El nombre va dentro de un archivo TOML: solo los caracteres que permite useradd.
  if [[ ! "$usuario" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
    log "nombre de usuario no válido para greetd ($usuario): no activo el inicio automático"
    return 1
  fi
  if [[ ! -f "$cfg" ]]; then
    log "no hay $cfg: no activo el inicio automático"
    return 1
  fi
  # Quita un [initial_session] anterior (hasta la siguiente cabecera) y agrega el de este usuario.
  tmp="$(mktemp)" || return 1
  awk '/^\[initial_session\][[:space:]]*$/ { salta = 1; next } /^\[/ { salta = 0 } !salta' "$cfg" >"$tmp"
  printf '\n[initial_session]\ncommand = "vortex-sesion"\nuser = "%s"\n' "$usuario" >>"$tmp"
  cat "$tmp" >"$cfg"   # cat y no mv: conserva dueño y permisos
  rm -f "$tmp"
  log "inicio de sesión automático para $usuario (greetd)"
}

paso_arranque() {
  # Calamares deja entradas de systemd-boot al estilo kernel-install: copias del kernel en
  # /boot/<machine-id>/<versión>/ que pacman no actualiza (al primer kernel nuevo no arrancaría),
  # tituladas «Arch Linux» y con el kernel de Arch por defecto. Se cambian por las de install.sh:
  # «Vortex OS» con linux-cachyos y el de Arch de respaldo, apuntando a /vmlinuz-* e
  # /initramfs-*.img, que mkinitcpio actualiza con cada kernel.
  local raiz="${VORTEX_RAIZ:-}" boot entradas opciones mid
  boot="$raiz/boot"
  entradas="$boot/loader/entries"
  [[ -d "$entradas" ]] || { log "no hay $entradas: no toco el arranque"; return 0; }
  opciones="$(cat "$raiz/etc/kernel/cmdline" 2>/dev/null || true)"
  if [[ -z "$opciones" ]]; then
    opciones="$(sed -n 's/^options[[:space:]]*//p' "$entradas"/*.conf 2>/dev/null | head -n1)"
  fi
  # Sin opciones repetidas (Calamares y kernel-install agregan root= y rootflags= cada uno).
  opciones="$(tr ' ' '\n' <<<"$opciones" | awk 'NF && !visto[$0]++' | grep -vx 'splash' | paste -sd ' ')"
  [[ "$opciones" == *root=* ]] || { log "no encontré root= en las opciones del kernel: no toco el arranque"; return 0; }
  printf '%s\n' "$opciones" >"$raiz/etc/kernel/cmdline"
  mid="$(cat "$raiz/etc/machine-id" 2>/dev/null || true)"
  rm -f "$entradas"/*.conf
  [[ -n "$mid" && -d "$boot/$mid" ]] && rm -rf "${boot:?}/$mid"
  local nombre kernel titulo
  for kernel in linux-cachyos linux; do
    [[ -e "$boot/vmlinuz-$kernel" ]] || continue
    if [[ "$kernel" == linux-cachyos ]]; then
      nombre=vortex-os titulo="Vortex OS"
    else
      nombre=vortex-os-arch titulo="Vortex OS (kernel de Arch, respaldo)"
    fi
    printf 'title   %s\nlinux   /vmlinuz-%s\ninitrd  /initramfs-%s.img\noptions %s\n' \
      "$titulo" "$kernel" "$kernel" "$opciones" >"$entradas/$nombre.conf"
  done
  local defecto=vortex-os.conf
  [[ -e "$entradas/$defecto" ]] || defecto=vortex-os-arch.conf
  printf 'default %s\ntimeout 3\nconsole-mode keep\n' "$defecto" >"$boot/loader/loader.conf"
  log "arranque: $(ls "$entradas" | tr '\n' ' ')(por defecto $defecto)"
  # Este script ya no sirve después de instalar.
  [[ -z "$raiz" ]] && rm -f /usr/local/bin/vortex-post-instalacion
  return 0
}

case "${1:-}" in
  kernel) paso_kernel ;;
  final) shift; paso_final "$@" ;;
  arranque) paso_arranque ;;
  inicio-automatico) shift; paso_inicio_automatico "$@" ;;
  *) echo "uso: vortex-post-instalacion kernel | final USUARIO | arranque | inicio-automatico USUARIO" >&2; exit 1 ;;
esac
