# remove from airootfs!
# Vortexine's OS: paru con RemoveMake activo desde la imagen, como lo deja install/10-repos.sh con sed.
# RemoveMake hace que paru borre las dependencias de compilación al terminar (cmake, meson,
# headers...), también cuando se llama sin --removemake («vortex actualizar», paru a mano).
# Corre al instalar paru en la imagen (mkarchiso); como este hook lleva la marca de arriba, el
# zzzz99-remove-custom-hooks-from-airootfs.hook de releng lo borra al terminar y no llega al
# sistema. /etc/paru.conf es un archivo de respaldo (backup) de paru: si paru se actualiza,
# pacman deja este cambio y pone la versión nueva en paru.conf.pacnew.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = paru

[Action]
Description = Activando RemoveMake en /etc/paru.conf...
When = PostTransaction
Depends = paru
Depends = sed
Exec = /usr/bin/sed -i 's/^#RemoveMake/RemoveMake/' /etc/paru.conf
